workflow Megaplan
  goal: "Create a high-quality sprint plan using multi-model orientation, drafting, critique, merge, and a quality gate before publishing."
  start: Start
  exit: Exit

  defaults
    max_retries: 5
    fidelity: summary:medium
    max_restarts: 5
    on_failure: Exit

  agent Start
    label: Start

  agent Exit
    label: Exit

  tool SetupEnvironment
    label: "Setup .ai workspace"
    timeout: 1m
    command_file: scripts/megaplan_quality/SetupEnvironment.sh

  tool DetermineSprintId
    label: "Determine Sprint ID"
    timeout: 1m
    command_file: scripts/megaplan_quality/DetermineSprintId.sh

  parallel OrientParallel -> OrientConventions, OrientLedger, OrientRecent, OrientSeedExplore

  agent OrientConventions
    label: "Read Conventions (Gemini)"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/OrientConventions.md

  agent OrientLedger
    label: "Check Ledger (Gemini)"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/OrientLedger.md

  agent OrientRecent
    label: "Analyze Recent Sprints (Claude)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/OrientRecent.md

  agent OrientSeedExplore
    label: "Explore Seed Context (Claude)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/OrientSeedExplore.md

  fan_in OrientJoin <- OrientConventions, OrientLedger, OrientRecent, OrientSeedExplore

  agent SynthesizeOrientation
    label: "Synthesize Orientation"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/SynthesizeOrientation.md

  parallel IntentParallel -> IntentClaude, IntentCodex, IntentGemini

  agent IntentClaude
    label: "Claude Intent"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/IntentClaude.md

  agent IntentCodex
    label: "Codex Intent"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/IntentCodex.md

  agent IntentGemini
    label: "Gemini Intent"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/IntentGemini.md

  fan_in IntentJoin <- IntentClaude, IntentCodex, IntentGemini

  parallel InitialDraftParallel -> DraftClaude, DraftCodex, DraftGemini

  agent DraftClaude
    label: "Claude Initial Draft"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/DraftClaude.md

  agent DraftCodex
    label: "Codex Initial Draft"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/DraftCodex.md

  agent DraftGemini
    label: "Gemini Initial Draft"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/DraftGemini.md

  fan_in InitialDraftJoin <- DraftClaude, DraftCodex, DraftGemini

  parallel QuestionsParallel -> QuestionsClaude, QuestionsCodex, QuestionsGemini

  agent QuestionsClaude
    label: "Claude Questions"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/QuestionsClaude.md

  agent QuestionsCodex
    label: "Codex Questions"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/QuestionsCodex.md

  agent QuestionsGemini
    label: "Gemini Questions"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/QuestionsGemini.md

  fan_in QuestionsJoin <- QuestionsClaude, QuestionsCodex, QuestionsGemini

  human InterviewGate
    label: "Interview Decision"

  agent CaptureInterview
    label: "Capture Interview Answers"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/CaptureInterview.md

  agent SkipInterview
    label: "Skip Interview"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: low
    prompt_file: prompts/megaplan_quality/SkipInterview.md

  parallel RevisedDraftParallel -> ReviseClaude, ReviseCodex, ReviseGemini

  agent ReviseClaude
    label: "Claude Revised Draft"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/ReviseClaude.md

  agent ReviseCodex
    label: "Codex Revised Draft"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/ReviseCodex.md

  agent ReviseGemini
    label: "Gemini Revised Draft"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/ReviseGemini.md

  fan_in RevisedDraftJoin <- ReviseClaude, ReviseCodex, ReviseGemini

  parallel CritiquesParallel -> CritiqueClaudeOnCodex, CritiqueClaudeOnGemini, CritiqueCodexOnClaude, CritiqueCodexOnGemini, CritiqueGeminiOnClaude, CritiqueGeminiOnCodex

  agent CritiqueClaudeOnCodex
    label: "Claude Critique of Codex"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/CritiqueClaudeOnCodex.md

  agent CritiqueClaudeOnGemini
    label: "Claude Critique of Gemini"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/CritiqueClaudeOnGemini.md

  agent CritiqueCodexOnClaude
    label: "Codex Critique of Claude"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/CritiqueCodexOnClaude.md

  agent CritiqueCodexOnGemini
    label: "Codex Critique of Gemini"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/CritiqueCodexOnGemini.md

  agent CritiqueGeminiOnClaude
    label: "Gemini Critique of Claude"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/CritiqueGeminiOnClaude.md

  agent CritiqueGeminiOnCodex
    label: "Gemini Critique of Codex"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/CritiqueGeminiOnCodex.md

  fan_in CritiquesJoin <- CritiqueClaudeOnCodex, CritiqueClaudeOnGemini, CritiqueCodexOnClaude, CritiqueCodexOnGemini, CritiqueGeminiOnClaude, CritiqueGeminiOnCodex

  parallel MergeAnalysisParallel -> CompareArchitectures, ExtractBestIdeas, SynthesizeCritiques

  agent CompareArchitectures
    label: "Compare Architectures"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/CompareArchitectures.md

  agent ExtractBestIdeas
    label: "Extract Best Ideas"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/ExtractBestIdeas.md

  agent SynthesizeCritiques
    label: "Synthesize Critiques"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/SynthesizeCritiques.md

  fan_in MergeAnalysisJoin <- CompareArchitectures, ExtractBestIdeas, SynthesizeCritiques

  agent WriteMergeNotes
    label: "Write Merge Notes"
    model: claude-haiku-4-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/WriteMergeNotes.md

  agent WriteFinalSprint
    label: "Write Final Sprint"
    model: claude-haiku-4-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/megaplan_quality/WriteFinalSprint.md

  agent FinalQualityGate
    label: "Final Quality Gate"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    max_retries: 1
    retry_target: RevisedDraftParallel
    prompt_file: prompts/megaplan_quality/FinalQualityGate.md

  tool PersistSprintPlaceholder
    label: "Persist Sprint Placeholder"
    timeout: 1m
    command_file: scripts/megaplan_quality/PersistSprintPlaceholder.sh

  tool SyncLedger
    label: "Sync Ledger"
    timeout: 1m
    command_file: scripts/megaplan_quality/SyncLedger.sh

  edges
    Start -> SetupEnvironment
    SetupEnvironment -> DetermineSprintId
    DetermineSprintId -> OrientParallel
    OrientJoin -> SynthesizeOrientation
    SynthesizeOrientation -> IntentParallel
    IntentJoin -> InitialDraftParallel
    InitialDraftJoin -> QuestionsParallel
    QuestionsJoin -> InterviewGate
    InterviewGate -> SkipInterview  label: "[S] Skip interview"
    InterviewGate -> CaptureInterview  label: "[A] Answer interview"
    CaptureInterview -> RevisedDraftParallel
    SkipInterview -> RevisedDraftParallel
    RevisedDraftJoin -> CritiquesParallel
    CritiquesJoin -> MergeAnalysisParallel
    MergeAnalysisJoin -> WriteMergeNotes
    WriteMergeNotes -> WriteFinalSprint
    WriteFinalSprint -> FinalQualityGate
    FinalQualityGate -> PersistSprintPlaceholder  on success  label: pass
    FinalQualityGate -> RevisedDraftParallel  on retry  label: rework  loop
    FinalQualityGate -> Exit  on fail  label: blocked
    FinalQualityGate -> Exit
    PersistSprintPlaceholder -> SyncLedger
    SyncLedger -> Exit
