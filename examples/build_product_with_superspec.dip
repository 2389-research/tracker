workflow BuildProductWithSuperspec
  goal: "Read a structured product spec with parallel work streams, execute streams respecting dependencies, enforce quality gates mechanically, cross-review the complete result, and verify full traceability."
  # Node bodies live in sidecars: agent prompts in prompts/build_product_with_superspec/<NodeID>.md,
  # tool commands in scripts/build_product_with_superspec/<NodeID>.sh (POSIX sh, run via `sh -c`).
  # SpecLint alone loads the SHARED prompts/build_product/SpecLint.md (#307 parity).
  requires: git
  start: Start
  exit: Done

  defaults
    max_retries: 3
    max_restarts: 20
    fidelity: full
    model: claude-sonnet-5
    provider: anthropic
    # Graph-level catch-all (#309), pointed at the fail-closed AbortRun
    # terminal (#640 A2 / #646): the old `on_failure: EscalateToHuman` turned
    # ANY unrouted failure — a stream agent dying mid-phase included — into
    # the "accept → Cleanup → FinalCommit" gate, which under --auto-approve
    # shipped whatever the tree held. Gates a human can meaningfully
    # override (SpecLint, FinalGates, TraceabilityAudit, the reviewers) route
    # to EscalateToHuman explicitly, whose unattended default is abandon.
    # Every OTHER mechanical tool node routes its own failure to AbortRun
    # (Setup, CommitScaffold, the SetupPhaseNWorktrees, Cleanup) or, for a
    # phase merge, to the MergeConflict gate; the phase gates (GatePhaseN /
    # GateStreamD) route a red result to their FixPhase loop.
    on_failure: AbortRun

  # Caller-supplied spec (#553). Supplied by a host (tracker-runner / Config.Inputs)
  # it is staged to .tracker/inputs/spec and adopted as SPEC.md; omitted, a
  # SPEC.md in the repo root is required. Not ${}-interpolated — inputs are
  # untrusted and never enter a shell command; Setup reads the fixed staged path.
  inputs
    spec: file
      prompt: "SPEC.md — what do you want built?"
      description: "The structured product spec. Supplied inline/by-path it is staged and built from; omitted, a SPEC.md in the repo root is required."

  agent Start
    label: Start

  agent Done
    label: Done

  # #646 (mirrors build_product's #640 A2 terminal): a mechanical workflow
  # step failed — a TOOL that exits 1, not a human gate, so it halts in every
  # mode (interactive, --auto-approve, --autopilot, --webhook); a gate's
  # unattended default would auto-advance. exit 1 + a single unconditional
  # edge to Done = strict-failure halt before Done, and the run ends `fail`.
  # Inline (not a sidecar) because it is a fixed three-line notice.
  tool AbortRun
    label: "Build aborted — a mechanical workflow step failed"
    timeout: 5s
    command:
      set -u
      echo "BUILD ABORTED: a mechanical (non-agent) workflow step failed; nothing was shipped."
      echo "The failing node and its stdout/stderr are in the activity log: run 'tracker diagnose' for the tail."
      echo "Fix the cause and start a new run: 'tracker -r' re-enters this terminal and cannot retry the failed step."
      exit 1

  # ═══════════════════════════════════════════════════════════════
  # Phase 1: Read, Plan, Scaffold
  # ═══════════════════════════════════════════════════════════════

  tool Setup
    label: "Setup Build Environment"
    timeout: 15s
    command_file: scripts/build_product_with_superspec/Setup.sh

  # ─── SpecLint: spec-coherence preflight (issue #301, epic #308 Phase 2) ──
  #
  # Runs ONCE, strictly before any spec read or decomposition. Hard-fails the
  # critical coherence classes (dangling refs, contradictory constants,
  # contract/signature mismatch, unassignable mandated tests) so no agent
  # builds on a broken spec. NOTE: this node is an intentional duplicate of
  # the SpecLint node in build_product.dip (not a shared subgraph) — built-in delivery
  # (embedded `tracker run build_product` outside the repo, library
  # tracker.Run, `tracker init`) cannot resolve subgraph file refs; dedup of
  # the two copies is tracked in issue #307. Both nodes load the SAME sidecar
  # (prompts/build_product/SpecLint.md), so the prompt is byte-identical by
  # construction — TestSpecLintPreflightPromptParity
  # (pipeline/spec_lint_preflight_test.go) still guards it. Only model /
  # reasoning_effort may differ between the two (this copy runs a higher tier).

  agent SpecLint
    label: "Spec Coherence Preflight"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/build_product/SpecLint.md

  agent AnalyzeSpec
    label: "Analyze Spec Structure"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/build_product_with_superspec/AnalyzeSpec.md

  agent BuildPlan
    label: "Build Execution Plan"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/build_product_with_superspec/BuildPlan.md

  human ApprovePlan
    label: "Review execution plan. Approve, adjust, or reject."
    mode: freeform
    default: approve

  # #646 5a: streams run in worktrees forked at HEAD, so the scaffold
  # (SPEC.md, docs/execution-plan.md, docs/traceability.yaml) must be
  # COMMITTED before the first worktree exists — by name, never `git add -A`.
  tool CommitScaffold
    label: "Commit Spec, Plan & Traceability Scaffold"
    timeout: 15s
    command_file: scripts/build_product_with_superspec/CommitScaffold.sh

  # ═══════════════════════════════════════════════════════════════
  # Phase 2: Foundation Streams (parallel)
  #   Stream A: Ingestion + normalization
  #   Stream B: Extraction
  # ═══════════════════════════════════════════════════════════════

  tool SetupPhase1Worktrees
    label: "Setup Phase 1 Worktrees"
    timeout: 15s
    command_file: scripts/build_product_with_superspec/SetupPhase1Worktrees.sh

  parallel Phase1Parallel -> StreamA, StreamB

  agent StreamA
    label: "Stream A: Ingestion & Normalization"
    model: claude-sonnet-5
    provider: anthropic
    working_dir: .ai/worktrees/stream-a
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/StreamA.md

  agent StreamB
    label: "Stream B: Entity & Event Extraction"
    model: gpt-5.5
    provider: openai
    working_dir: .ai/worktrees/stream-b
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/StreamB.md

  fan_in Phase1Join <- StreamA, StreamB

  tool MergePhase1
    label: "Merge Phase 1 & Run Gates"
    timeout: 120s
    command_file: scripts/build_product_with_superspec/MergePhase1.sh

  tool GatePhase1
    label: "Quality Gates: Phase 1"
    timeout: 300s
    command_file: scripts/build_product_with_superspec/GatePhase1.sh

  agent FixPhase1
    label: "Fix Phase 1 Gate Failures"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/FixPhase1.md

  # ═══════════════════════════════════════════════════════════════
  # Phase 3: Core Streams (parallel where possible)
  #   Stream C: Event engine (depends on B)
  #   Stream E: Ranking (independent)
  # ═══════════════════════════════════════════════════════════════

  tool SetupPhase2Worktrees
    label: "Setup Phase 2 Worktrees"
    timeout: 15s
    command_file: scripts/build_product_with_superspec/SetupPhase2Worktrees.sh

  parallel Phase2Parallel -> StreamC, StreamE

  agent StreamC
    label: "Stream C: Event Engine"
    model: claude-opus-5
    provider: anthropic
    working_dir: .ai/worktrees/stream-c
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/StreamC.md

  agent StreamE
    label: "Stream E: Ranking & Materialization"
    model: gpt-5.5
    provider: openai
    working_dir: .ai/worktrees/stream-e
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/StreamE.md

  fan_in Phase2Join <- StreamC, StreamE

  tool MergePhase2
    label: "Merge Phase 2 & Run Gates"
    timeout: 120s
    command_file: scripts/build_product_with_superspec/MergePhase2.sh

  tool GatePhase2
    label: "Quality Gates: Phase 2"
    timeout: 300s
    command_file: scripts/build_product_with_superspec/GatePhase2.sh

  agent FixPhase2
    label: "Fix Phase 2 Gate Failures"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/FixPhase2.md

  # ═══════════════════════════════════════════════════════════════
  # Phase 4: Story Engine (depends on Event Engine)
  #   Stream D: Story assembly, angles, narrative tracking
  # ═══════════════════════════════════════════════════════════════

  agent StreamD
    label: "Stream D: Story Engine"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/StreamD.md

  tool GateStreamD
    label: "Quality Gates: Stream D"
    timeout: 300s
    command_file: scripts/build_product_with_superspec/GateStreamD.sh

  agent FixStreamD
    label: "Fix Stream D Gate Failures"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/FixStreamD.md

  # ═══════════════════════════════════════════════════════════════
  # Phase 5: Surface Streams (parallel)
  #   Stream F: UI/API
  #   Stream G: Ops + observability
  # ═══════════════════════════════════════════════════════════════

  tool SetupPhase4Worktrees
    label: "Setup Phase 4 Worktrees"
    timeout: 15s
    command_file: scripts/build_product_with_superspec/SetupPhase4Worktrees.sh

  parallel Phase4Parallel -> StreamF, StreamG

  agent StreamF
    label: "Stream F: UI & API"
    model: claude-sonnet-5
    provider: anthropic
    working_dir: .ai/worktrees/stream-f
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/StreamF.md

  agent StreamG
    label: "Stream G: Ops & Observability"
    model: gpt-5.5
    provider: openai
    working_dir: .ai/worktrees/stream-g
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/StreamG.md

  fan_in Phase4Join <- StreamF, StreamG

  tool MergePhase4
    label: "Merge Phase 4 & Run Gates"
    timeout: 120s
    command_file: scripts/build_product_with_superspec/MergePhase4.sh

  tool GatePhase4
    label: "Quality Gates: Phase 4"
    timeout: 300s
    command_file: scripts/build_product_with_superspec/GatePhase4.sh

  agent FixPhase4
    label: "Fix Phase 4 Gate Failures"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/FixPhase4.md

  # ═══════════════════════════════════════════════════════════════
  # Phase 6: Quality & Docs Streams (parallel)
  #   Stream H: Evaluation & QA
  #   Stream I: Docs & compliance
  # ═══════════════════════════════════════════════════════════════

  tool SetupPhase5Worktrees
    label: "Setup Phase 5 Worktrees"
    timeout: 15s
    command_file: scripts/build_product_with_superspec/SetupPhase5Worktrees.sh

  parallel Phase5Parallel -> StreamH, StreamI

  agent StreamH
    label: "Stream H: Evaluation & QA"
    model: claude-sonnet-5
    provider: anthropic
    working_dir: .ai/worktrees/stream-h
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/StreamH.md

  agent StreamI
    label: "Stream I: Docs & Compliance"
    model: gpt-5.5
    provider: openai
    working_dir: .ai/worktrees/stream-i
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/StreamI.md

  fan_in Phase5Join <- StreamH, StreamI

  tool MergePhase5
    label: "Merge Phase 5 & Run Gates"
    timeout: 120s
    command_file: scripts/build_product_with_superspec/MergePhase5.sh

  # ═══════════════════════════════════════════════════════════════
  # Phase 7: Cross-Review
  # Three reviewers with different perspectives review the COMPLETE product.
  # ═══════════════════════════════════════════════════════════════

  parallel ReviewParallel -> ReviewArchitect, ReviewQA, ReviewProduct
    params:
      fan_in_policy: all

  agent ReviewArchitect
    label: "Architect Review"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/build_product_with_superspec/ReviewArchitect.md

  agent ReviewQA
    label: "QA Review"
    model: gpt-5.5
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/build_product_with_superspec/ReviewQA.md

  agent ReviewProduct
    label: "Product Review"
    model: gemini-2.5-pro
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/build_product_with_superspec/ReviewProduct.md

  fan_in ReviewJoin <- ReviewArchitect, ReviewQA, ReviewProduct

  agent SynthesizeReviews
    label: "Synthesize Cross-Reviews"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/build_product_with_superspec/SynthesizeReviews.md

  agent ApplyReviewFixes
    label: "Apply Review Fixes"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/build_product_with_superspec/ApplyReviewFixes.md

  # ═══════════════════════════════════════════════════════════════
  # Phase 8: Final Verification
  # Mechanical gate enforcement + traceability check + human sign-off
  # ═══════════════════════════════════════════════════════════════

  tool FinalGates
    label: "Enforce ALL Quality Gates"
    timeout: 600s
    command_file: scripts/build_product_with_superspec/FinalGates.sh

  agent TraceabilityAudit
    label: "Traceability Audit"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    fallback_target: EscalateToHuman
    auto_status: true
    prompt_file: prompts/build_product_with_superspec/TraceabilityAudit.md

  # Reached from SpecLint, the reviewers (ReviewParallel), FinalGates and
  # TraceabilityAudit failing. "abandon" is the default (#646): the
  # deterministic --auto-approve picks the default and the LLM autopilots
  # are biased to it, so an unattended run never ships red final gates
  # through "accept" — that edge is an audited override (override: true).
  human EscalateToHuman
    label: "Build needs human intervention. Review and decide."
    mode: freeform
    default: abandon

  # #646 5c: a phase merge that conflicts (or fails for any reason) lands
  # here with the conflict list — never at the accept gate. The merge was
  # aborted (`git merge --abort || true`), every stream worktree/branch is
  # untouched. "abandon" is listed FIRST and is the default, so an
  # unattended run halts at AbortRun; "retry" (after the human merged the
  # conflicting branch by hand in the workdir) re-enters the SAME phase's
  # merge via RetryMerge, which skips branches already in HEAD.
  human MergeConflict
    label: "Phase merge failed — resolve by hand, then retry, or abandon"
    mode: freeform
    default: abandon
    prompt:
      A phase merge failed. The merge was aborted; the stream worktrees under
      .ai/worktrees/ and their build/<stream> branches are untouched.

      ${ctx.tool_stdout}

      Options:
      - **abandon** (default): stop the run (AbortRun). Nothing is shipped.
      - **retry**: you have resolved it in the workdir (`git merge
        build/<stream>`, fix conflicts, commit) — re-run this phase's merge;
        branches already in HEAD are skipped.

  tool RetryMerge
    label: "Route Back to the Failed Phase Merge"
    timeout: 5s
    command_file: scripts/build_product_with_superspec/RetryMerge.sh

  tool Cleanup
    label: "Clean Build Artifacts"
    timeout: 15s
    command_file: scripts/build_product_with_superspec/Cleanup.sh

  agent FinalCommit
    label: "Final Commit"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: low
    auto_status: true
    fallback_target: EscalateToHuman
    prompt_file: prompts/build_product_with_superspec/FinalCommit.md

  # ═══════════════════════════════════════════════════════════════
  # Edges
  # ═══════════════════════════════════════════════════════════════

  edges
    Start -> Setup
    # #640 A2 / #646: the mechanical (tool) nodes with no human-recoverable
    # failure route their own failure to the AbortRun terminal (the
    # graph-level on_failure points there too); see the defaults comment.
    Setup -> AbortRun  when ctx.outcome = fail
    Setup -> SpecLint
    # Spec-coherence preflight (#301): the fail edge is explicit — a node with a
    # conditional success edge does NOT fall through to the graph-level
    # on_failure cascade for an unmatched fail outcome. Conditions are
    # exhaustive; no unconditional fallback (it would race the conditionals).
    SpecLint -> AnalyzeSpec  when ctx.outcome = success
    SpecLint -> EscalateToHuman  when ctx.outcome = fail
    AnalyzeSpec -> BuildPlan
    BuildPlan -> ApprovePlan
    ApprovePlan -> CommitScaffold  label: "approve"
    CommitScaffold -> AbortRun  when ctx.outcome = fail
    CommitScaffold -> SetupPhase1Worktrees
    ApprovePlan -> BuildPlan  label: "adjust"  restart: true
    ApprovePlan -> Done  label: "reject"

    # Phase 2: Foundation (A + B parallel)
    SetupPhase1Worktrees -> AbortRun  when ctx.outcome = fail
    SetupPhase1Worktrees -> Phase1Parallel
    Phase1Join -> MergePhase1
    MergePhase1 -> GatePhase1  when ctx.outcome = success
    MergePhase1 -> MergeConflict  when ctx.outcome = fail
    MergePhase1 -> AbortRun
    GatePhase1 -> SetupPhase2Worktrees  when ctx.outcome = success
    GatePhase1 -> FixPhase1  when ctx.outcome = fail
    GatePhase1 -> EscalateToHuman
    FixPhase1 -> GatePhase1  restart: true

    # Phase 3: Core (C + E parallel)
    SetupPhase2Worktrees -> AbortRun  when ctx.outcome = fail
    SetupPhase2Worktrees -> Phase2Parallel
    Phase2Join -> MergePhase2
    MergePhase2 -> GatePhase2  when ctx.outcome = success
    MergePhase2 -> MergeConflict  when ctx.outcome = fail
    MergePhase2 -> AbortRun
    GatePhase2 -> StreamD  when ctx.outcome = success
    GatePhase2 -> FixPhase2  when ctx.outcome = fail
    GatePhase2 -> EscalateToHuman
    FixPhase2 -> GatePhase2  restart: true

    # Phase 4: Story engine (D sequential, depends on C)
    StreamD -> GateStreamD
    GateStreamD -> SetupPhase4Worktrees  when ctx.outcome = success
    GateStreamD -> FixStreamD  when ctx.outcome = fail
    GateStreamD -> EscalateToHuman
    FixStreamD -> GateStreamD  restart: true

    # Phase 5: Surface (F + G parallel)
    SetupPhase4Worktrees -> AbortRun  when ctx.outcome = fail
    SetupPhase4Worktrees -> Phase4Parallel
    Phase4Join -> MergePhase4
    MergePhase4 -> GatePhase4  when ctx.outcome = success
    MergePhase4 -> MergeConflict  when ctx.outcome = fail
    MergePhase4 -> AbortRun
    GatePhase4 -> SetupPhase5Worktrees  when ctx.outcome = success
    GatePhase4 -> FixPhase4  when ctx.outcome = fail
    GatePhase4 -> EscalateToHuman
    FixPhase4 -> GatePhase4  restart: true

    # Phase 6: Quality & Docs (H + I parallel)
    SetupPhase5Worktrees -> AbortRun  when ctx.outcome = fail
    SetupPhase5Worktrees -> Phase5Parallel
    Phase5Join -> MergePhase5
    MergePhase5 -> ReviewParallel  when ctx.outcome = success
    MergePhase5 -> MergeConflict  when ctx.outcome = fail
    MergePhase5 -> AbortRun

    # #646 5c: merge-conflict recovery. RetryMerge prints the exact marker
    # for the phase recorded by the failed merge (endswith — #640 A3); the
    # unconditional fallback is the terminal (safe: not a loop target).
    MergeConflict -> AbortRun  label: "abandon"
    MergeConflict -> RetryMerge  label: "retry"
    RetryMerge -> MergePhase1  when ctx.tool_stdout endswith retry-merge-phase1  restart: true
    RetryMerge -> MergePhase2  when ctx.tool_stdout endswith retry-merge-phase2  restart: true
    RetryMerge -> MergePhase4  when ctx.tool_stdout endswith retry-merge-phase4  restart: true
    RetryMerge -> MergePhase5  when ctx.tool_stdout endswith retry-merge-phase5  restart: true
    RetryMerge -> AbortRun

    # Phase 7: Cross-review
    # The three reviewers run as parallel branches; a branch runs via
    # ParallelHandler (registry.Execute), bypassing the engine's strict-failure
    # path, so a per-branch fallback_target would be inert (the engine now
    # refuses one at dispatch). ReviewParallel declares fan_in_policy: all
    # (issue #313), so this edge fires when ANY of the three reviewers fails —
    # a single missing review perspective can no longer be masked by the
    # default success-if-any aggregation. On success the parallel handler's
    # suggested-next routes to ReviewJoin.
    ReviewParallel -> EscalateToHuman  when ctx.outcome = fail
    ReviewJoin -> SynthesizeReviews
    SynthesizeReviews -> FinalGates  when ctx.outcome = success
    SynthesizeReviews -> ApplyReviewFixes  when ctx.outcome = fail
    SynthesizeReviews -> Done
    ApplyReviewFixes -> FinalGates

    # Phase 8: Final verification
    FinalGates -> TraceabilityAudit  when ctx.outcome = success
    FinalGates -> EscalateToHuman  when ctx.outcome = fail
    FinalGates -> EscalateToHuman
    TraceabilityAudit -> Cleanup  when ctx.outcome = success
    TraceabilityAudit -> EscalateToHuman  when ctx.outcome = fail
    TraceabilityAudit -> EscalateToHuman
    # "abandon" is listed FIRST and is the node's default: the deterministic
    # --auto-approve takes the first label of a freeform gate (the dippin
    # `default:` lands in default_choice, which the freeform path does not
    # read), so both must agree or an unattended run ships red final gates.
    EscalateToHuman -> Done  label: "abandon"
    # "accept" overrides the failed goal gate (#348 defect 2): the run completes
    # as validation_overridden instead of the gate re-running. Routing unchanged.
    EscalateToHuman -> Cleanup  label: "accept"  override: true
    Cleanup -> AbortRun  when ctx.outcome = fail
    Cleanup -> FinalCommit
    FinalCommit -> Done
    # exit 1 + a single unconditional edge => strict-failure halt before Done.
    AbortRun -> Done
