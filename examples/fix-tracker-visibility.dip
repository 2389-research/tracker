workflow FixTrackerVisibility
  goal: "Diagnose and fix the tracker TUI's silent periods where it appears locked up, using multi-model ideation and iterative ralph-loop implementation."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    max_restarts: 20
    fidelity: summary:high
    on_failure: Exit

  agent Start
    label: Start

  agent Exit
    label: Exit

  agent ExploreVisibilityGaps
    label: "Explore Visibility Gaps"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    max_turns: 30
    max_retries: 3
    retry_target: ExploreVisibilityGaps
    prompt_file: prompts/fix-tracker-visibility/ExploreVisibilityGaps.md

  agent IdeateOpus
    label: "Ideate (Opus)"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    max_turns: 20
    max_retries: 2
    prompt_file: prompts/fix-tracker-visibility/IdeateOpus.md

  agent IdeateGPT
    label: "Ideate (GPT)"
    model: gpt-5.4
    provider: openai
    reasoning_effort: high
    max_turns: 20
    max_retries: 2
    prompt_file: prompts/fix-tracker-visibility/IdeateGPT.md

  agent IdeateGemini
    label: "Ideate (Gemini)"
    model: gpt-4o
    provider: openai
    reasoning_effort: high
    max_turns: 20
    max_retries: 2
    prompt_file: prompts/fix-tracker-visibility/IdeateGemini.md

  agent BuildConsensus
    label: "Build Consensus Plan"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    max_turns: 30
    max_retries: 2
    prompt_file: prompts/fix-tracker-visibility/BuildConsensus.md

  tool SetupRalphState
    label: "Setup Ralph State"
    timeout: 1m
    command_file: scripts/fix-tracker-visibility/SetupRalphState.sh

  tool IncrementCounter
    label: "Increment Iteration"
    timeout: 1m
    command_file: scripts/fix-tracker-visibility/IncrementCounter.sh

  agent RalphIterate
    label: "Ralph Iterate"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    max_turns: 50
    max_retries: 3
    retry_target: RalphIterate
    prompt_file: prompts/fix-tracker-visibility/RalphIterate.md

  tool CheckCompletion
    label: "Check Completion"
    timeout: 1m
    command_file: scripts/fix-tracker-visibility/CheckCompletion.sh

  tool CheckBudget
    label: "Check Iteration Budget"
    timeout: 1m
    command_file: scripts/fix-tracker-visibility/CheckBudget.sh

  tool FinalBuild
    label: "Final Build & Test"
    timeout: 2m
    command_file: scripts/fix-tracker-visibility/FinalBuild.sh

  agent WrapUp
    label: "Wrap Up"
    model: claude-haiku-4-5
    provider: anthropic
    reasoning_effort: high
    max_retries: 2
    prompt_file: prompts/fix-tracker-visibility/WrapUp.md

  edges
    Start -> ExploreVisibilityGaps
    ExploreVisibilityGaps -> IdeateOpus
    IdeateOpus -> IdeateGPT
    IdeateGPT -> IdeateGemini
    IdeateGemini -> BuildConsensus
    BuildConsensus -> SetupRalphState
    SetupRalphState -> IncrementCounter
    IncrementCounter -> RalphIterate
    RalphIterate -> CheckCompletion
    CheckCompletion -> Exit  when ctx.tool_stdout = complete  label: "all done"
    CheckCompletion -> CheckBudget  when ctx.tool_stdout = continue  label: "more work"
    CheckCompletion -> CheckBudget  label: "fallback — assume continue"
    CheckBudget -> IncrementCounter  when ctx.tool_stdout = budget_ok  label: "next iteration"  restart: true
    CheckBudget -> FinalBuild  when ctx.tool_stdout = budget_exhausted  label: "out of iterations"
    CheckBudget -> FinalBuild  label: "fallback — assume exhausted"
    FinalBuild -> WrapUp  when ctx.tool_stdout = build_pass  label: "build ok"
    FinalBuild -> WrapUp  label: "build issues"
    WrapUp -> Exit
