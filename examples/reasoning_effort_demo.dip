# Demonstration of reasoning_effort feature
# This pipeline shows how to use reasoning_effort on agent nodes

workflow ReasoningEffortDemo
  goal: "Demonstrate reasoning_effort configuration in Dippin workflows"
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    fidelity: summary:medium
    on_failure: Exit

  agent Start
    label: Start

  agent Exit
    label: Exit

  agent SimpleTask
    label: "Simple Task"
    reasoning_effort: low
    prompt_file: prompts/reasoning_effort_demo/SimpleTask.md

  agent ComplexTask
    label: "Complex Task"
    reasoning_effort: high
    prompt_file: prompts/reasoning_effort_demo/ComplexTask.md

  agent MediumTask
    label: "Medium Task"
    reasoning_effort: medium
    prompt_file: prompts/reasoning_effort_demo/MediumTask.md

  edges
    Start -> SimpleTask
    SimpleTask -> ComplexTask
    ComplexTask -> MediumTask
    MediumTask -> Exit
