workflow ConsensusTaskParity
  goal: "$task"
  start: Start
  exit: Exit

  defaults
    max_retries: 3
    fidelity: truncate
    max_restarts: 5
    on_failure: Exit

  agent Start
    label: Start

  agent Exit
    label: Exit

  agent CheckDoD
    label: "Refine DoD"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    max_retries: 1
    prompt_file: prompts/consensus_task_parity/CheckDoD.md

  parallel DoDParallel -> DefineDoD_Gemini, DefineDoD_GPT, DefineDoD_Opus

  agent DefineDoD_Gemini
    label: "Refine DoD (Gemini)"
    model: gemini-3.1-pro-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/DefineDoD_Gemini.md

  agent DefineDoD_GPT
    label: "Refine DoD (GPT)"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/DefineDoD_GPT.md

  agent DefineDoD_Opus
    label: "Refine DoD (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/DefineDoD_Opus.md

  fan_in DoDJoin <- DefineDoD_Gemini, DefineDoD_GPT, DefineDoD_Opus

  agent ConsolidateDoD
    label: "Consolidate DoD"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/ConsolidateDoD.md

  parallel PlanParallel -> PlanGemini, PlanGPT, PlanOpus

  agent PlanGemini
    label: "Plan (Gemini)"
    model: gemini-3.1-pro-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/PlanGemini.md

  agent PlanGPT
    label: "Plan (GPT)"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/PlanGPT.md

  agent PlanOpus
    label: "Plan (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/PlanOpus.md

  fan_in PlanJoin <- PlanGemini, PlanGPT, PlanOpus

  agent DebateConsolidate
    label: "Debate & Consolidate"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/DebateConsolidate.md

  agent Implement
    label: Implement
    model: gpt-5.3-codex
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/Implement.md

  agent VerifyOutputs
    label: "Verify Outputs"
    model: claude-haiku-4-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/VerifyOutputs.md

  parallel ReviewParallel -> ReviewGemini, ReviewGPT, ReviewOpus

  agent ReviewGemini
    label: "Review (Gemini)"
    model: gemini-3.1-pro-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/ReviewGemini.md

  agent ReviewGPT
    label: "Review (GPT)"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/ReviewGPT.md

  agent ReviewOpus
    label: "Review (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/ReviewOpus.md

  fan_in ReviewJoin <- ReviewGemini, ReviewGPT, ReviewOpus

  agent ReviewConsensus
    label: "Review Consensus"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    max_retries: 1
    retry_target: Implement
    prompt_file: prompts/consensus_task_parity/ReviewConsensus.md

  agent Postmortem
    label: Postmortem
    model: claude-haiku-4-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task_parity/Postmortem.md

  edges
    Start -> CheckDoD
    CheckDoD -> DoDParallel
    DoDJoin -> ConsolidateDoD
    ConsolidateDoD -> PlanParallel
    PlanJoin -> DebateConsolidate
    DebateConsolidate -> Implement
    Implement -> VerifyOutputs
    VerifyOutputs -> ReviewParallel
    ReviewJoin -> ReviewConsensus
    ReviewConsensus -> Exit  on success  label: pass
    ReviewConsensus -> Postmortem  on retry  label: retry
    ReviewConsensus -> Exit  on fail  label: fail
    ReviewConsensus -> Exit  label: "fallback to exit"
    Postmortem -> PlanParallel  when ctx.internal.loop_restart_count = 0  label: retry_once  loop
    Postmortem -> Exit  when ctx.internal.loop_restart_count != 0  label: stop_after_retry
    Postmortem -> Exit  label: "fallback to exit"
