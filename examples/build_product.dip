workflow BuildProduct
  goal: "Read a SPEC.md, decompose into milestones, implement each with verification loops, cross-review the complete result, and verify full spec compliance."
  # Node bodies live in sidecars: agent prompts in prompts/build_product/<NodeID>.md,
  # tool commands in scripts/build_product/<NodeID>.sh (POSIX sh, run via `sh -c`).
  requires: git
  start: Start
  exit: Done

  defaults
    max_retries: 3
    # Restart budgets are per loop ITERATION (#643): an inner loop's count
    # (TestMilestone/CommitIfDirty fix loops) resets each time the enclosing
    # milestone loop advances via MarkMilestoneDone -> PickNextMilestone. The
    # milestone loop itself is outermost, so this value is ALSO the run-wide
    # cap on milestones — a safety net sized above any plausible plan, not a
    # fix-loop budget. It is the ceiling for EVERY loop, so the 50 -> 200 bump
    # also raises the per-milestone engine bound on a fix loop 4x. The
    # TestMilestone-red path is bounded tighter by the on-disk
    # .ai/milestones/fix_attempts counter; the Verify-fail loop (TestMilestone
    # green -> VerifyMilestone fail -> FixMilestone) is NOT — TestMilestone.sh
    # resets fix_attempts on green — and needs its own on-disk breaker (#640 A4).
    max_restarts: 200
    fidelity: full
    model: claude-sonnet-5
    provider: anthropic
    # Graph-level catch-all is the fail-closed ABORT terminal, never a human
    # gate (#640 A2). The old `on_failure: EscalateReview` turned every
    # strict-failure tool node (Setup, CommitIfDirty,
    # MarkMilestoneDone, ClearStaleReviews, ResetReviewBudget, Cleanup — and
    # even the fail-closed SpecForgeFailed terminal) into a route to the
    # POST-BUILD accept gate, whose unattended default is accept -> Cleanup ->
    # FinalCommit -> Done: "SPEC.md not found" shipped as validation_overridden.
    # Every agent node already owns its failure route (a fail edge or a
    # node-level fallback_target — pinned by TestBuildProductAgentNodesHave-
    # FailureRouting); the mechanical tool nodes route `when ctx.outcome = fail`
    # to the AbortRun terminal below instead. The graph-level catch-all is
    # kept only as a fail-closed backstop, pointed at that same terminal:
    # anything with no route of its own (a passthrough Start, a parallel
    # reviewer branch — whose per-branch route is inert, see #296) aborts.
    on_failure: AbortRun

  # Caller-supplied spec (#553). When a host supplies it (tracker-runner, or
  # `Config.Inputs`), the engine stages the file to .tracker/inputs/spec and
  # Setup adopts it as SPEC.md. Optional: with no supplied value, a SPEC.md in
  # the repo root is used (the classic flow). Not ${}-interpolated — inputs are
  # untrusted and never enter a shell command; Setup reads the fixed staged path.
  inputs
    spec: file
      prompt: "SPEC.md — what do you want built?"
      description: "The product spec. Supplied inline/by-path it is staged and built from; omitted, a SPEC.md in the repo root is required."

  agent Start
    label: Start

  agent Done
    label: Done

  # Fail-closed terminal for MECHANICAL failures (#640 A2): a workflow tool
  # node (Setup, CommitIfDirty, MarkMilestoneDone, ...) exited non-zero. A
  # TOOL that exits 1 — NOT a human gate — so it halts in every mode
  # (interactive, --auto-approve, --autopilot, --webhook); a gate's unattended
  # default would auto-advance. Same shape as SpecForgeFailed: exit 1 + a single
  # unconditional edge to Done = strict-failure halt before Done, and the run
  # ends `fail`. Because it is also the graph-level on_failure backstop, the
  # engine re-enters it ONCE as its own fallback (idempotent: echo + exit 1)
  # before the one-shot latch (#642) halts the run — cosmetic, not a loop.
  # Inline (not a sidecar) because it is a fixed three-line notice.
  # The failing node's stdout/stderr can't be interpolated into a tool_command
  # (ctx.tool_stderr is LLM-origin, off the safe-key allowlist); they are in
  # the activity log, which `tracker diagnose` reads.
  tool AbortRun
    label: "Build aborted — a mechanical workflow step failed"
    timeout: 5s
    command:
      set -u
      echo "BUILD ABORTED: a mechanical (non-agent) workflow step failed; nothing was shipped."
      echo "The failing node and its stdout/stderr are in the activity log: run 'tracker diagnose' for the tail."
      echo "Fix the cause, then re-run (or 'tracker -r <run-id>' to resume from the checkpoint)."
      exit 1

  # ─── Phase 1: Read & Plan ──────────────────────────────────

  tool Setup
    label: "Setup Build Workspace"
    timeout: 10s
    command_file: scripts/build_product/Setup.sh

  # ─── SpecLint: spec-coherence preflight (issue #301, epic #308 Phase 2) ──
  #
  # Runs ONCE, strictly before any spec read or decomposition. Hard-fails the
  # critical coherence classes (dangling refs, contradictory constants,
  # contract/signature mismatch, unassignable mandated tests) so no agent
  # builds on a broken spec. NOTE: this node is intentionally duplicated (not
  # a shared subgraph) in build_product_with_superspec.dip — built-in delivery
  # (embedded `tracker run build_product` outside the repo, library
  # tracker.Run, `tracker init`) cannot resolve subgraph file refs; dedup of
  # the two copies is tracked in issue #307. Both nodes load the SAME sidecar
  # (prompts/build_product/SpecLint.md), so the prompt is byte-identical by
  # construction — TestSpecLintPreflightPromptParity
  # (pipeline/spec_lint_preflight_test.go) still guards it. Only model /
  # reasoning_effort may differ between the two (superspec runs a higher tier).

  agent SpecLint
    label: "Spec Coherence Preflight"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: medium
    auto_status: true
    prompt_file: prompts/build_product/SpecLint.md

  agent ReadSpec
    label: "Read & Analyze Spec"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: medium
    prompt_file: prompts/build_product/ReadSpec.md

  # ─── Spec-forge loop (autonomous SPEC.md hardening) ─────────
  # When SpecLint fails, an autonomous ForgeSpec edits SPEC.md to resolve the
  # findings, a fidelity oracle proves it didn't cheat by deleting requirements,
  # and we re-lint until clean — capped by an on-disk budget, failing CLOSED if
  # it can't converge. Only SpecLint drives this loop (ReadSpec's fail is an
  # infra fault). This hardens STRUCTURAL coherence + conservative gaps; it does
  # NOT certify semantic consistency.
  tool CheckSpecForgeBudget
    label: "Spec-Forge Budget Gate"
    timeout: 5s
    command_file: scripts/build_product/CheckSpecForgeBudget.sh

  agent ForgeSpec
    label: "Harden SPEC.md to pass coherence"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/build_product/ForgeSpec.md

  agent CheckSpecFidelity
    label: "Verify no requirement was dropped"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/build_product/CheckSpecFidelity.md

  tool SpecForgeFailed
    label: "Spec could not be hardened — stopping"
    timeout: 10s
    command_file: scripts/build_product/SpecForgeFailed.sh

  agent Decompose
    label: "Decompose into Milestones"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/build_product/Decompose.md

  # ShowPlan reads the plan artifacts Decompose just wrote into ctx.tool_stdout
  # so the ApprovePlan gate can render them for review. Without this the operator
  # saw only the bare label and could not actually review anything — they'd
  # rubber-stamp `approve`. Safe pattern (CLAUDE.md): a tool node cats the files,
  # the human prompt interpolates ${ctx.tool_stdout} (allowed in prompts). The
  # files are guarded so a (shouldn't-happen) missing file can't strict-fail the
  # gate out of the run.
  tool ShowPlan
    label: "Show Plan for Review"
    timeout: 10s
    # ctx.tool_stdout keeps only the tail up to this cap (default 64KB). Raise it
    # to 1MB so a large plan + coverage table isn't clipped before the operator
    # sees it at ApprovePlan (PR #414 review).
    output_limit: 1048576
    command_file: scripts/build_product/ShowPlan.sh

  human ApprovePlan
    label: "Review the milestone plan — approve, adjust, or reject"
    mode: freeform
    default: approve
    # The plan + spec-coverage table is interpolated below via ${ctx.tool_stdout}
    # (populated by the ShowPlan tool node) so this renders in the fullscreen
    # review modal with the real plan, not a bare one-line label.
    prompt:
      Review the milestone plan the planner just produced, then choose:

      - **approve** (default): the plan is sound — start building milestone 1.
      - **adjust**: send it back to re-plan. Use the freeform box to say what to
        change (scope, ordering, a missing requirement, an over-broad milestone).
      - **reject**: abandon the build entirely.

      Before approving, skim the plan below for: milestones in a sensible build
      order, each with a concrete "Done when" and a verify command; a sane
      "DO NOT implement" scope line; and — in the coverage table — every
      spec-mandated verification mapped to an owning (or deferred) milestone with
      `COVERAGE_GAPS: 0`. A non-zero gap count or an over-broad milestone is a
      reason to **adjust**.

      Also review the spec ambiguity rulings and behavioral contracts below
      (written by ReadSpec): each contradiction has exactly ONE definite
      ruling, and each prose guarantee has a concrete verification method.
      A ruling you disagree with, or a missing/needed ruling, is a reason to
      **adjust** — this is your one chance to correct a wrong interpretation
      before the build commits to it.

      If the "Spec auto-hardening log" below is non-empty, SPEC.md was
      **auto-hardened** by the spec-forge loop before planning — each entry
      changed the source of truth. A ruling or elaboration you disagree with is
      a reason to **adjust**; this is your one checkpoint on the machine's
      interpretation before the build commits to it.

      ---
      ## Plan under review

      The milestone plan and the spec requirement-coverage table the planner
      wrote — each file's contents verbatim under a section heading that names
      its source path. Delimited under its own heading — never interpolated
      mid-sentence.

      ${ctx.tool_stdout}

  # ─── Phase 2: Build Loop ───────────────────────────────────
  #
  # The engine processes milestones sequentially. The Implement agent
  # reads .ai/milestones/current.md to know what to build next.
  # After each milestone, Verify checks it. On success, Advance moves
  # to the next milestone. On failure, the fix loop retries.
  #
  # When all milestones are done, Advance routes to cross-review.

  tool PickNextMilestone
    label: "Pick Next Milestone"
    timeout: 10s
    command_file: scripts/build_product/PickNextMilestone.sh

  agent Implement
    label: "Implement Current Milestone"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    max_turns: 50
    fallback_target: EscalateMilestone
    # Turn-limit commit-if-green guard (#297/#303/#406). If this session
    # exhausts its turn budget on a GREEN tree, the breach verifier runs this
    # command; exit 0 classifies the breach verified_green (outcome=success) so
    # the finished work is committed instead of abandoned. Same script the
    # TestMilestone gate wraps — one source of truth.
    params:
      verify_command: sh .ai/build/verify.sh
    prompt_file: prompts/build_product/Implement.md

  tool CommitIfDirty
    label: "Commit working tree if dirty"
    timeout: 30s
    command_file: scripts/build_product/CommitIfDirty.sh

  tool ContinueWithMoreTurns
    label: "Warm continue: bump turn budget (capped)"
    timeout: 5s
    command_file: scripts/build_product/ContinueWithMoreTurns.sh

  tool TestMilestone
    label: "Test Current Milestone"
    timeout: 300s
    command_file: scripts/build_product/TestMilestone.sh

  agent VerifyMilestone
    label: "Verify Milestone Completion"
    model: claude-sonnet-5
    provider: anthropic
    # #490 Option C: the verifier's cost is driven by TURN COUNT (git archaeology
    # + per-literal grep), not reasoning depth — so medium effort keeps the check
    # coverage while cutting the reasoning-token spend. Reversible; validated by an
    # A/B on VerifyMilestone provider_totals.
    reasoning_effort: medium
    auto_status: true
    prompt_file: prompts/build_product/VerifyMilestone.md

  tool MarkMilestoneDone
    label: "Mark Milestone Complete"
    timeout: 5s
    command_file: scripts/build_product/MarkMilestoneDone.sh

  # Verify-fail loop breaker (#640 A4). The TestMilestone-red fix loop is
  # bounded by .ai/milestones/fix_attempts, but TestMilestone.sh RESETS that
  # counter on green — so a VerifyMilestone that keeps rejecting a green tree
  # (e.g. "files outside scope" on already-committed files) looped Fix ->
  # Test(green) -> Verify(fail) to the engine ceiling and died at a gate-less
  # terminal. This gate sits on the Verify-fail path only: gate-BEFORE-work
  # `-gt 3` = exactly 3 verify-driven fixes, then EscalateMilestone. The counter
  # (.ai/milestones/verify_fail_attempts) is cleared by MarkMilestoneDone and
  # on a fresh Setup, never here.
  tool CheckVerifyFailBudget
    label: "Verify-Fail Budget Gate"
    timeout: 5s
    command_file: scripts/build_product/CheckVerifyFailBudget.sh

  agent FixMilestone
    label: "Fix Milestone Issues"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    max_turns: 50
    retry_target: TestMilestone
    max_retries: 5
    fallback_target: EscalateMilestone
    # Turn-limit commit-if-green guard (#406). The fix loop is the node that
    # actually reached green at turn 47 in run 634a2527ff56 and then burned the
    # budget on read-only `git status` — without this verifier its breach
    # classified operator_decision and the green fix was abandoned uncommitted.
    # Exit 0 → verified_green → the verified_green edge below commits the tree.
    params:
      verify_command: sh .ai/build/verify.sh
    prompt_file: prompts/build_product/FixMilestone.md

  # ─── Phase 3: Cross-Review ─────────────────────────────────

  # Structural existence gate (issue #350). TestMilestone's `go test ./...`
  # sentinel is blind to ABSENT packages — a package that was never created
  # produces no failing tests, so a silently-skipped milestone sails into the
  # review fan-out, where (case study b68b532619c3) five agents spent ~$10 and
  # 32 minutes independently running `ls cmd/goblin` to rediscover that the
  # final milestone shipped empty. This sub-second gate reconciles the outputs
  # Decompose DECLARED (the per-milestone **Files**: lines in milestones.md)
  # against what is ON DISK, before any reviewer token is spent. It guards
  # BOTH entries to the review fan-out: the all-done path from
  # PickNextMilestone and the capped re-review restart loop (ApplyReviewFixes
  # can delete or move declared outputs too).
  #
  # Failure granularity (the deletion caveat): Decompose's Files lists include
  # files to DELETE — destructive work is its own milestone by the Decompose
  # rules — so a missing FILE may be a legitimate deletion, not a skipped
  # milestone. File-level misses are therefore reported as warnings only.
  # The gate FAILS on the structural class: a declared output DIRECTORY that
  # does not exist (cmd/goblin/ never created — the actual #350 case), or a
  # broken `go build ./...` on a Go stack. Failure routes to the
  # EscalateMilestone HUMAN gate — a false positive (e.g. a whole declared
  # directory legitimately removed) costs the operator one glance, while the
  # silent skip it prevents costs the full review fan-out.
  #
  # Stack detection mirrors ci-probe (go.mod / package.json / pyproject.toml /
  # Cargo.toml): Go gets `go build ./...` on top of the existence checks;
  # other stacks get the existence checks only (sub-second contract — their
  # build/test gates already ran in TestMilestone and run again in FinalBuild).
  # The milestones.md parse follows the CLAUDE.md LLM-written-file rules:
  # flexible header regex, blank-line stripping, empty-extraction guard that
  # fails loudly, and the extracted tokens are only ever used in quoted
  # `[ -d ]` / `[ -e ]` tests — never eval'd, never interpolated into a command.
  tool CheckMilestoneOutputs
    label: "Check Declared Milestone Outputs Exist"
    timeout: 300s
    command_file: scripts/build_product/CheckMilestoneOutputs.sh

  tool ClearStaleReviews
    label: "Clear Stale Review Reports"
    timeout: 5s
    command_file: scripts/build_product/ClearStaleReviews.sh

  # #418: compute the cumulative base..worktree review diff ONCE so the three
  # reviewers read a bounded diff as their PRIMARY input instead of each
  # re-reading the whole tree (the ~90%-of-tokens problem). BASE is the run's
  # base commit captured at Setup (.ai/build/run-base-sha); degrade to the
  # empty tree when it is empty (fresh repo) or unreachable (history rewrite)
  # — the SAME empty-tree-fallback idiom verify.sh and MarkMilestoneDone
  # already use. Unlike those two-dot (BASE..HEAD) call sites, this is a
  # one-arg `git diff <BASE>` WORKTREE compare: the "accept" gate routes here
  # WITHOUT committing first, so the diff must capture accepted-but-uncommitted
  # work, not just commits. The full tree stays available on demand
  # (the reviewers may read any file); this only POINTS their primary read.
  # The diff is advisory context, so the whole body is best-effort and the
  # routing marker is printed last.
  tool ComputeReviewDiff
    label: "Compute Cumulative Review Diff"
    timeout: 60s
    # Reviewers read the FILE (.ai/build/review-diff.md), not this node's
    # streams: stdout is only the short readiness marker and stderr is only the
    # failure WARNING (any git error text is redirected INTO the file via 2>&1,
    # not onto a node stream). So output_limit does not bound the diff/error
    # content reviewers consume — it only caps this node's marker + warning
    # streams as surfaced by `tracker diagnose`. Kept generous purely as harmless
    # headroom so a future stderr diagnostic is never clipped.
    output_limit: 1048576
    command_file: scripts/build_product/ComputeReviewDiff.sh

  parallel ReviewParallel -> ReviewClaude, ReviewCodex, ReviewGemini
    params:
      fan_in_policy: all

  # Phase 3 reviewers (issue #233 Gap 2). All three carry the same 5-point
  # structured rubric so the synthesis step can compare findings on equal
  # footing. Lane-specific framing follows the shared rubric so each reviewer
  # contributes a distinct angle (general / quality / adversarial) without
  # any one of them having permission to skip the spec-literal grep, the
  # interface-caller check, the test-contract check, the scope-creep check,
  # or the spec-marker warning. Pre-#233 the three prompts were 4-8 lines
  # each of free-form focus areas; ReviewGemini returned "PASS / PASS /
  # PASS / PASS" reading the spec's own ✅ markers as evidence, missing
  # the API-shape blocker, off-by-one retries, fingerprints scope creep,
  # CI red, and the dead interface methods.

  agent ReviewClaude
    label: "Claude Review (general)"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/build_product/ReviewClaude.md

  agent ReviewCodex
    label: "Codex Review (quality)"
    model: gpt-5.5
    provider: openai
    reasoning_effort: high
    # #353: the OpenAI lane reports zero prompt-cache reads, so a slow turn loop
    # re-sends the growing transcript as fresh billed input — the case study's
    # $7.35 runaway (legit reviewers were $0.17–$1.56). Cap this un-cached lane
    # and FAIL (not retry — retry re-runs the expensive node) so a breach routes
    # to the EscalateReview human gate with no data loss. $4 is a CONSERVATIVE
    # floor from the single real case study (2.5x over the observed legit max);
    # tighten toward p95 once production cost-distribution data accrues (the
    # `tracker diagnose` cost_asymmetry detector surfaces the peak). Reversible;
    # the cached Anthropic lane (ReviewClaude) stays uncapped — caching makes a
    # runaway there far less likely.
    params:
      max_cost_usd: 4.00
      cost_exceeded_action: fail
    prompt_file: prompts/build_product/ReviewCodex.md

  agent ReviewGemini
    label: "Gemini Review (adversarial)"
    model: gemini-2.5-pro
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/build_product/ReviewGemini.md

  fan_in ReviewJoin <- ReviewClaude, ReviewCodex, ReviewGemini

  tool CheckReviewsComplete
    label: "Verify All Reviews Present"
    timeout: 5s
    command_file: scripts/build_product/CheckReviewsComplete.sh

  agent SynthesizeReviews
    label: "Synthesize Reviews"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/build_product/SynthesizeReviews.md

  agent ApplyReviewFixes
    label: "Apply Review Fixes"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    fallback_target: EscalateReview
    prompt_file: prompts/build_product/ApplyReviewFixes.md

  tool CheckReviewFixBudget
    label: "Re-Review Budget Gate"
    timeout: 5s
    command_file: scripts/build_product/CheckReviewFixBudget.sh

  # ─── Phase 4: Final Verification ───────────────────────────

  tool FinalBuild
    label: "Final Build & Test"
    timeout: 600s
    command_file: scripts/build_product/FinalBuild.sh

  agent FinalSpecCheck
    label: "Final Spec Compliance"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    fallback_target: EscalateReview
    auto_status: true
    prompt_file: prompts/build_product/FinalSpecCheck.md

  human OperatorDecision
    label: "Agent hit its turn limit mid-progress — pick how to proceed"
    mode: freeform
    # Issue #318 hazard 1 (CRITICAL): make the unattended default deterministically
    # SAFE so a headless run never silently advances unverified work. TWO operative
    # mechanisms, both resolving to "stop":
    #   1. Edge order — the freeform interviewer's unattended path falls back to the
    #      FIRST outgoing edge label (labels[0]). The edges below list stop/abandon
    #      BEFORE continue, so --auto-approve / --webhook-url pick "stop".
    #   2. `default: stop` — dippin maps this to `default_choice`, which is what the
    #      gate's TIMEOUT path resolves (HumanConfig.DefaultChoice). Also documents
    #      intent. (Note: freeform's labels[0] fallback, not default_choice, drives
    #      the auto-approve path — keep stop first so both agree.)
    # --autopilot lax/mentor bias to "forward progress" and are NOT deterministically
    # safe here; the prompt frames "continue" as the RISKY option to bias the LLM
    # judge away from it.
    default: stop
    prompt:
      The implementation agent ran out of its turn budget while still making
      steady progress: it did NOT enter a detected loop, and its work did NOT
      verify green (either of those would have routed elsewhere). Its final
      status and output are shown below — read them before choosing.

      Options:
      - **stop** (default; chosen automatically for unattended runs): Treat the
        milestone as stuck and escalate to the milestone gate. Preserves work.
        This is the SAFE choice — it never silently advances unverified work.
      - **abandon**: Kill the pipeline immediately.
      - **commit_advance**: You have inspected the working tree and judge it good
        enough. Commit it and advance to verification as if the milestone passed.
        Only pick this AFTER reviewing the work.
      - **continue**: RISKY. Hand the agent a fresh, larger turn budget and let
        it keep going (warm — it keeps its episode memory). Bounded by a hard cap
        on consecutive continues; past the cap this escalates instead of looping.

  human EscalateMilestone
    label: "Milestone stuck — pick how to proceed"
    mode: freeform
    # #407: `mark done` is FIRST and the default so the unattended path (freeform
    # labels[0] fallback + default_choice) preserves work — it NEVER discards.
    # `abandon` is demoted to the destructive last resort. The "Verify currently"
    # block surfaces the live build/verify output that routed here so a green,
    # passing tree is never thrown away by an operator who wasn't told it passes
    # (run 634a2527ff56 abandoned a green build). A green-at-breach turn limit no
    # longer even reaches this gate — #406 routes it to CommitIfDirty — but other
    # paths (a Verify false-positive over passing tests, an escalate sentinel)
    # can still land here on a green tree, so the state must be shown.
    default: mark done
    prompt:
      The build loop hit a wall on the current milestone.
      The agent tried to fix it but couldn't get tests to pass.

      READ "Most recent tool output" at the END of this prompt before choosing.
      If it shows `tests-pass` the tree is GREEN — do NOT abandon; pick
      **mark done** (or **accept** to ship). Abandoning a passing tree discards
      finished work. If it ends in `verify-budget-exhausted` the tree IS green
      but the verifier rejected it 3 times — its findings are in the
      "Last agent response" block. If it shows a PickNextMilestone ERROR, the
      plan file is malformed: no option here re-plans, so **abandon** and fix
      .ai/decisions/milestones.md (or re-run) rather than **retry**, which
      would implement an empty milestone.

      Options:
      - **mark done** (default; chosen automatically for unattended runs): Override the failure — you've confirmed the milestone is complete. Commits/continues to the next milestone. Preserves work. This is an audited override: the run completes `validation_overridden`, not `success`.
      - **retry**: Re-implement this milestone from scratch. Does NOT re-plan. Preserves prior commits.
      - **mark a known failure, then retry**: if a specific test or lint rule is a
        false positive the milestone can't fix, add it and pick **retry**. Test
        names go in `.ai/milestones/known_failures` (one per line); golangci-lint
        exclude patterns go in `.ai/milestones/known_lint_failures`. The next
        attempt re-runs the gate with those suppressions applied.
      - **accept**: Stop building more milestones and ship what exists — but still run the full cross-review, final build/test, and spec-compliance gates first (does NOT skip verification).
      - **abandon**: DESTRUCTIVE LAST RESORT. Kill the pipeline immediately and discard uncommitted work. Only pick this if the output below shows a red tree (or a malformed plan) and the build is genuinely unsalvageable.

      ---
      ## Most recent tool output

      Tail (64KB cap) of the stdout of whichever TOOL node ran last before this
      gate — TestMilestone (build/verify), CheckVerifyFailBudget,
      CheckMilestoneOutputs, PickNextMilestone or ContinueWithMoreTurns — so
      read its final marker to know which. It is NOT necessarily verify output:
      after a VerifyMilestone rejection it is the budget gate's marker, and the
      verifier's findings are in the "Last agent response" below. A trailing
      `tests-pass` means the tree is green; a trailing `escalate` means the
      fix loop exhausted its budget on a red tree. Delimited under its own
      heading — never interpolated mid-sentence.

      ${ctx.tool_stdout}

      ## Most recent tool stderr

      ${ctx.tool_stderr}

      ## Last agent response

      The most recent agent's final message (VerifyMilestone's verdict when
      routed via the verify-fail budget; Implement/FixMilestone's status
      otherwise).

      ${ctx.last_response}

  human EscalateReview
    label: "Review flagged issues — pick how to proceed"
    mode: freeform
    default: accept
    prompt:
      A planning, review or verification step failed and routed here. This
      gate is reached from: ReadSpec / Decompose failing (before any code
      exists), a reviewer or the review-completeness check failing, the
      re-review budget running out, FinalBuild red, FinalSpecCheck fail, or
      FinalCommit failing. Read the diagnostics at the END of this prompt to
      see which — the right choice depends on it.

      Options:
      - **accept**: Ship as-is. The findings are acceptable or already
        addressed. This is an audited override (the run completes
        `validation_overridden`). Do NOT accept a red FinalBuild or a planning
        failure with no code behind it.
      - **retry**: Go back to Decompose and re-plan the build from scratch
        (keeps commits; resets the re-review budget).
      - **abandon**: Kill the pipeline.

      ---
      ## Most recent tool output

      Tail (64KB cap) of the stdout of whichever TOOL node ran last —
      FinalBuild, CheckReviewsComplete, CheckReviewFixBudget, ComputeReviewDiff
      or an earlier node if an AGENT routed here (then see the agent response
      below). Delimited under its own heading — never interpolated mid-sentence.

      ${ctx.tool_stdout}

      ## Most recent tool stderr

      ${ctx.tool_stderr}

      ## Last agent response

      The final message of the most recent agent (FinalSpecCheck's compliance
      verdict, SynthesizeReviews, ReadSpec/Decompose's status, ...).

      ${ctx.last_response}

  tool ResetReviewBudget
    label: "Reset Re-Review Budget"
    timeout: 5s
    command_file: scripts/build_product/ResetReviewBudget.sh

  tool Cleanup
    label: "Clean Build Artifacts"
    timeout: 10s
    command_file: scripts/build_product/Cleanup.sh

  agent FinalCommit
    label: "Final Commit"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: low
    auto_status: true
    fallback_target: EscalateReview
    # #349 wanted a mechanical scope guard here — `writable_paths: .git/**, .ai/**`
    # via the native fs-jail (#272) so the node could `git add`/`git commit` but
    # never author product source. It is deliberately NOT declared (#642):
    # writable_paths refuses to start anywhere Landlock ABI v3 is unavailable
    # (macOS, Linux < 6.2, or any non-native backend), and build_product must
    # run on macOS — with the jail declared, FinalCommit could never finish there
    # (it escalated once, then hard-stopped). dippin has no platform-gated attr,
    # so until a degrade-with-warning mode exists the commit_only prompt +
    # system-prompt guard below is the sole scope defense on this node.
    params:
      commit_only: true
    prompt_file: prompts/build_product/FinalCommit.md

  # ─── Edges ─────────────────────────────────────────────────

  edges
    Start -> Setup
    # #640 A2: every mechanical (tool) node routes its own failure to the
    # AbortRun terminal (the graph-level on_failure now points there too), so
    # a `set -e` abort in Setup ("SPEC.md not found") ends the run `fail`
    # instead of reaching the post-build accept gate and shipping.
    Setup -> AbortRun  when ctx.outcome = fail
    Setup -> SpecLint
    # Spec-coherence preflight (#301): success/fail conditions are exhaustive —
    # no unconditional fallback (it would race the conditional edges).
    SpecLint -> ReadSpec  when ctx.outcome = success
    # Spec-forge loop: a failing coherence gate no longer dead-ends at a human —
    # an autonomous ForgeSpec edits SPEC.md and we re-lint, capped by an on-disk
    # budget and a fidelity oracle, failing CLOSED if it can't converge.
    SpecLint -> CheckSpecForgeBudget  when ctx.outcome = fail
    CheckSpecForgeBudget -> ForgeSpec  when ctx.outcome = success
    CheckSpecForgeBudget -> SpecForgeFailed
    ForgeSpec -> CheckSpecFidelity  when ctx.outcome = success
    # Unconditional fallback (safe: SpecForgeFailed is a terminal, not a loop
    # target) catches fail / too-thin / unexpected — mirrors TestMilestone.
    ForgeSpec -> SpecForgeFailed
    CheckSpecFidelity -> SpecLint  when ctx.outcome = success  restart: true
    CheckSpecFidelity -> SpecForgeFailed
    # exit 1 + a single unconditional edge => strict-failure halt before Done.
    SpecForgeFailed -> Done
    # ReadSpec's fail is an INFRA fault (no auto_status), not a spec-quality
    # signal — it must NOT enter the forge loop. Unchanged:
    ReadSpec -> Decompose  when ctx.outcome = success
    ReadSpec -> EscalateReview  when ctx.outcome = fail
    Decompose -> ShowPlan  when ctx.outcome = success
    Decompose -> EscalateReview  when ctx.outcome = fail
    # ShowPlan reads the plan files into ctx.tool_stdout, then the human reviews.
    ShowPlan -> AbortRun  when ctx.outcome = fail
    ShowPlan -> ApprovePlan
    ApprovePlan -> PickNextMilestone  label: "approve"
    ApprovePlan -> Decompose  label: "adjust"  restart: true
    ApprovePlan -> Done  label: "reject"

    # Build loop: pick → implement → test → verify → mark done → pick next
    #
    # #640 A1: the fail edge is FIRST and the Implement edge is guarded on
    # outcome = success. Pre-#640 `not contains all-done` had no outcome
    # guard, so any exit-1 pick (no headers, extraction failure, missing
    # .ai/build) — whose stdout naturally lacks "all-done" — sent Implement
    # (Opus, 50 turns) to build an EMPTY current.md, and the EscalateMilestone
    # edge was dead code. Markers are matched with `endswith` (#640 A3): every
    # script prints its routing marker LAST via printf with no trailing
    # newline, so the suffix is exact — a plan section that merely mentions
    # "all-done" mid-output can no longer end the build loop early.
    PickNextMilestone -> EscalateMilestone  when ctx.outcome = fail
    PickNextMilestone -> CheckMilestoneOutputs  when ctx.tool_stdout endswith all-done
    PickNextMilestone -> Implement  when ctx.outcome = success and ctx.tool_stdout not endswith all-done
    PickNextMilestone -> EscalateMilestone
    # #350 structural existence gate: declared milestone outputs must be on
    # disk (and `go build ./...` green on a Go stack) before the expensive
    # review fan-out. Routes on the end-of-stdout markers (printed LAST via
    # printf with no trailing newline, so they survive tail-capture by
    # construction and `endswith` matches them exactly — #640 A3). Fail routes to
    # the operator-recoverable EscalateMilestone gate, NOT back into a fix
    # loop: a missing-deleted-dir false positive must cost one human glance,
    # never an auto-fail loop. The unconditional fallback catches a gate run
    # that crashed before printing either marker (timeout, set -eu abort) —
    # same anomaly posture as PickNextMilestone's fallback above.
    # outputs-missing is evaluated FIRST (kept from the `contains` era: with
    # `endswith` only the final marker counts, but fail-first is still the
    # conservative order if the script ever prints trailing diagnostics).
    CheckMilestoneOutputs -> EscalateMilestone  when ctx.tool_stdout endswith outputs-missing
    CheckMilestoneOutputs -> ClearStaleReviews  when ctx.tool_stdout endswith outputs-present
    CheckMilestoneOutputs -> EscalateMilestone
    Implement -> CommitIfDirty  when ctx.outcome = success
    # #318: a steady-progress turn breach (verify ran but wasn't green, no loop)
    # routes to the operator-decision gate. Narrow `= operator_decision` so a
    # pathological breach (and any plain fail) still falls through to the
    # unconditional EscalateMilestone catch-all below.
    Implement -> OperatorDecision  when ctx.turn_breach_class = operator_decision
    Implement -> EscalateMilestone
    # #318 operator-decision routes. stop/abandon are listed BEFORE continue so
    # the freeform labels[0] fallback (if `default` were ever dropped) is safe.
    OperatorDecision -> EscalateMilestone      label: "stop"
    OperatorDecision -> Done                   label: "abandon"
    OperatorDecision -> CommitIfDirty          label: "commit_advance"
    OperatorDecision -> ContinueWithMoreTurns  label: "continue"
    # Capped warm-retry: success re-enters Implement (warm, bumped MaxTurns);
    # cap-exhausted (fail) escalates instead of looping forever. The trailing
    # unconditional -> EscalateMilestone is the strict-failure catch-all (mirrors
    # TestMilestone): conditional edges are tried first, so it only ever fires on
    # an unexpected outcome — and it keeps the node's printed markers covered.
    ContinueWithMoreTurns -> Implement          when ctx.outcome = success  restart: true
    ContinueWithMoreTurns -> EscalateMilestone  when ctx.outcome = fail
    ContinueWithMoreTurns -> EscalateMilestone
    CommitIfDirty -> AbortRun  when ctx.outcome = fail
    CommitIfDirty -> TestMilestone
    TestMilestone -> VerifyMilestone  when ctx.outcome = success
    # #640 A3: `endswith escalate`, not `contains` — the 64KB test-output tail
    # can legitimately contain the word (a package named escalate, a log line)
    # and `contains` skipped the fix loop straight to the gate whose
    # unattended default is mark-done. TestMilestone.sh prints the marker LAST
    # with no trailing newline; a normal red run prints no marker at all and
    # falls to the generic fail edge below.
    TestMilestone -> EscalateMilestone  when ctx.tool_stdout endswith escalate
    TestMilestone -> FixMilestone  when ctx.outcome = fail
    TestMilestone -> EscalateMilestone
    VerifyMilestone -> MarkMilestoneDone  when ctx.outcome = success
    # #640 A4: the verify-fail path passes through its own on-disk budget gate
    # (see the CheckVerifyFailBudget node comment) — never straight into
    # FixMilestone, whose Test->Fix counter is reset by the green run that
    # preceded every verify rejection.
    VerifyMilestone -> CheckVerifyFailBudget  when ctx.outcome = fail
    VerifyMilestone -> EscalateMilestone
    CheckVerifyFailBudget -> FixMilestone  when ctx.outcome = success
    CheckVerifyFailBudget -> EscalateMilestone  when ctx.outcome = fail
    MarkMilestoneDone -> AbortRun  when ctx.outcome = fail
    MarkMilestoneDone -> PickNextMilestone  restart: true
    # #406: a turn-limit breach that reached a GREEN tree (verify_command exit 0)
    # classifies verified_green (outcome=success). Commit the finished work via
    # the same durable-persistence node the #318 commit_advance path uses, then
    # re-verify through TestMilestone. Narrow `= verified_green` so a normal
    # (non-breach) fix carries no turn_breach_class and still falls through to
    # the warm restart loop below.
    #
    # PR #411 (Codex P1): turn_breach_class is STICKY in context, so a
    # verified_green value left by an EARLIER milestone's breach could route a
    # later NORMAL fail (outcome=fail) down the commit edge and checkpoint a
    # non-green tree. We exploit first-match edge ordering (selectByCondition
    # returns the first matching conditional edge in declaration order): a
    # `when ctx.outcome = fail -> TestMilestone` edge declared BEFORE the commit
    # edge short-circuits EVERY fail back to re-verify, so a stale
    # verified_green class can never commit a non-green tree. Only a genuine
    # green breach (outcome=success) falls past it to the commit edge.
    #
    # #640 A5: the three edges are EXHAUSTIVE on outcome (fail / success) — the
    # old trailing unconditional `-> TestMilestone` duplicated the conditional
    # edge to the same loop target, the exact pattern CLAUDE.md forbids.
    #
    # NOTE: these conditional edges make FixMilestone `hasAnyConditionalEdge`,
    # which disables engine strict-fail on this node — so a pathological/non-green
    # breach no longer escalates via fallback_target. Instead its outcome=fail
    # routes it (via the first edge below) to TestMilestone, which deterministically
    # re-runs verify.sh on the (still non-green) tree, increments the on-disk
    # fix-attempt counter, and escalates to EscalateMilestone once that counter
    # exceeds its cap (bounded, counter-driven escalation; no infinite loop, no
    # work loss).
    FixMilestone -> TestMilestone  when ctx.outcome = fail  restart: true
    FixMilestone -> CommitIfDirty  when ctx.turn_breach_class = verified_green  restart: true
    FixMilestone -> TestMilestone  when ctx.outcome = success  restart: true

    # Milestone escalation — human decides per-milestone.
    # #640 A6: "mark done" stays the unattended default (#407: never discard
    # work; `retry` would burn up to max_restarts Opus re-implementations on a
    # milestone that cannot go green and still end at a gate-less terminal) but
    # it is an AUDITED override: EventValidationOverridden fires and the run
    # completes validation_overridden, never a clean success — so an
    # --auto-approve run over a red milestone can't pass for a green one.
    EscalateMilestone -> MarkMilestoneDone  label: "mark done"  override: true
    EscalateMilestone -> Implement  label: "retry"  restart: true
    # #392/#730: "accept" means "operator has decided to ship what exists,
    # stop building more milestones" — but it must NOT ship UNVERIFIED. The
    # pre-#392 edge jumped straight to Cleanup -> FinalCommit -> Done, bypassing
    # the entire cross-review + FinalBuild (whole-tree `go test ./...`) +
    # FinalSpecCheck subgraph, so a run could exit Done over a red suite with no
    # compliance report. #392 then routed accept BACK into CheckMilestoneOutputs
    # — but that is the very check the operator is overriding, so when the
    # structural gate flags (a false positive on a green tree, OR a true
    # positive the operator has chosen to accept anyway) accept deterministically
    # re-enters the failing check -> outputs-missing -> EscalateMilestone, an
    # inescapable loop where only "abandon" (discard the whole run) exits. That
    # is the #730 trap. Route accept FORWARD into the ship/review path at
    # ClearStaleReviews instead: it still earns the three-way cross-review, the
    # final whole-tree build/test, and the spec-compliance check before Cleanup
    # (satisfying #392), but it does NOT pass back through the structural gate the
    # operator is explicitly overriding — so accept is always a real forward exit
    # that can ship a green (or operator-accepted) tree. restart: true resets the
    # restart budget as accept leaves the per-milestone loop for the review phase
    # (mirrors MarkMilestoneDone -> PickNextMilestone).
    EscalateMilestone -> ClearStaleReviews  label: "accept"  restart: true
    EscalateMilestone -> Done  label: "abandon"

    # Cross-review
    # ClearStaleReviews wipes prior-round reports before fan-out so the
    # post-join CheckReviewsComplete guard (issue #313) can't be satisfied by a
    # stale file from an earlier re-review pass.
    ClearStaleReviews -> AbortRun  when ctx.outcome = fail
    ClearStaleReviews -> ComputeReviewDiff
    ComputeReviewDiff -> AbortRun  when ctx.outcome = fail
    ComputeReviewDiff -> ReviewParallel
    # The three reviewers run as parallel branches; a branch runs via
    # ParallelHandler (registry.Execute), bypassing the engine's strict-failure
    # path, so a per-branch fallback_target would be inert. Route failure on the
    # aggregating ReviewParallel node instead. ReviewParallel declares
    # fan_in_policy: all (issue #313, dippin-lang v0.39.0), so this fires when
    # ANY of the three reviewers fails — a single missing adversarial review can
    # no longer be masked by the default success-if-any aggregation. On success
    # the parallel handler's suggested-next routes to ReviewJoin.
    #
    # Defense-in-depth stays at CheckReviewsComplete below: it fails loudly if
    # any of the three review reports is missing/empty and routes to
    # EscalateReview (catches a reviewer that "succeeds" without writing its
    # report, which no aggregation policy can see).
    ReviewParallel -> EscalateReview  when ctx.outcome = fail
    ReviewJoin -> CheckReviewsComplete
    CheckReviewsComplete -> SynthesizeReviews  when ctx.outcome = success
    CheckReviewsComplete -> EscalateReview  when ctx.outcome = fail
    SynthesizeReviews -> FinalBuild  when ctx.outcome = success
    SynthesizeReviews -> ApplyReviewFixes  when ctx.outcome = fail
    SynthesizeReviews -> EscalateReview

    # Post-fix re-review gate (issue #233 Gap 5.3). ApplyReviewFixes
    # may introduce W4/W5/W13 regressions (zero-assertion, wrong-target,
    # DI bypass) that the pre-fix reviewer rubrics already passed; the
    # downstream FinalSpecCheck deliberately scopes to W17 + iface +
    # SPEC.md per Gap 8 v5, so without this gate post-fix smells would
    # reach Done unchecked. CheckReviewFixBudget caps the re-review
    # loop at MAX_ATTEMPTS=1 — a clean re-review proceeds to FinalBuild
    # via SynthesizeReviews's existing success edge; an exhausted budget
    # escalates to a human.
    ApplyReviewFixes -> CheckReviewFixBudget  when ctx.outcome = success
    ApplyReviewFixes -> EscalateReview
    # #350: the re-review restart loop ALSO passes through the structural
    # gate — ApplyReviewFixes can delete or move declared outputs, and the
    # gate is sub-second.
    CheckReviewFixBudget -> CheckMilestoneOutputs  when ctx.outcome = success  restart: true
    CheckReviewFixBudget -> EscalateReview  when ctx.outcome = fail

    # Final verification
    FinalBuild -> FinalSpecCheck  when ctx.outcome = success
    FinalBuild -> EscalateReview  when ctx.outcome = fail
    FinalBuild -> EscalateReview
    FinalSpecCheck -> Cleanup  when ctx.outcome = success
    FinalSpecCheck -> EscalateReview  when ctx.outcome = fail
    FinalSpecCheck -> EscalateReview

    # Review escalation — human decides for the whole build.
    # "accept" overrides the failed FinalSpecCheck goal gate (#348 defect 2):
    # the run completes as validation_overridden instead of the gate re-running
    # and draining budget. Audit-only — routing to Cleanup is unchanged.
    EscalateReview -> Cleanup  label: "accept"  override: true
    EscalateReview -> ResetReviewBudget  label: "retry"
    ResetReviewBudget -> AbortRun  when ctx.outcome = fail
    ResetReviewBudget -> Decompose  restart: true
    EscalateReview -> Done  label: "abandon"

    Cleanup -> AbortRun  when ctx.outcome = fail
    Cleanup -> FinalCommit
    # #640 A2 terminal: exit 1 + a single unconditional edge => strict-failure
    # halt before Done (same shape as SpecForgeFailed).
    AbortRun -> Done
    # FinalCommit failure routes via fallback_target: EscalateReview (node attr),
    # not a catch-all edge — Cleanup is reachable from EscalateReview (accept), so a
    # FinalCommit -> EscalateReview edge would close an unconditional cycle (DIP005).
    FinalCommit -> Done
