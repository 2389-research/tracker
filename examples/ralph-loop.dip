workflow RalphLoop
  goal: "Reusable iterative implementation loop. Feed the same task repeatedly, letting the agent see its own prior work in files and git history, until completion criteria are met or max iterations exhausted."
  start: Start
  exit: Exit

  defaults
    model: claude-haiku-4-5
    provider: anthropic
    max_retries: 2
    max_restarts: 10
    on_failure: Exit
    fidelity: summary:high

  agent Start
    label: Start

  agent Exit
    label: Exit

  agent Iterate
    label: "Ralph Iterate"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    max_turns: 50
    max_retries: 3
    retry_target: Iterate
    prompt_file: prompts/ralph-loop/Iterate.md
  tool CheckCompletion
    label: "Check Completion"
    timeout: 1m
    command_file: scripts/ralph-loop/CheckCompletion.sh
  tool IncrementCounter
    label: "Increment Iteration"
    timeout: 1m
    command_file: scripts/ralph-loop/IncrementCounter.sh
  tool CheckBudget
    label: "Check Iteration Budget"
    timeout: 1m
    command_file: scripts/ralph-loop/CheckBudget.sh
  agent WrapUp
    label: "Wrap Up (Budget Exhausted)"
    model: claude-haiku-4-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/ralph-loop/WrapUp.md
  edges
    Start -> IncrementCounter
    IncrementCounter -> Iterate
    Iterate -> CheckCompletion
    CheckCompletion -> Exit  when ctx.tool_stdout = complete  label: done
    CheckCompletion -> CheckBudget  when ctx.tool_stdout = continue  label: "more work needed"
    CheckCompletion -> CheckBudget  label: "fallback to continue"
    CheckBudget -> IncrementCounter  when ctx.tool_stdout = budget_ok  label: "next iteration"  restart: true
    CheckBudget -> WrapUp  when ctx.tool_stdout = budget_exhausted  label: "out of iterations"
    CheckBudget -> WrapUp  label: "fallback to wrap up"
    WrapUp -> Exit
