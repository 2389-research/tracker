workflow AskAndExecute
  goal: "Ask the user what to build, explore and spec it, fan out to 3 isolated implementations via git worktrees, cross-critique, select the best, apply it, and clean up everything else."
  # Node bodies live in sidecars: agent prompts in prompts/ask_and_execute/<NodeID>.md,
  # tool commands in scripts/ask_and_execute/<NodeID>.sh (POSIX sh, run via `sh -c`).
  requires: git
  start: Start
  exit: Done

  defaults
    max_retries: 2
    max_restarts: 50
    fidelity: summary:high
    model: claude-sonnet-5
    provider: anthropic
    # Graph-level catch-all (#309), pointed at the fail-closed AbortRun
    # terminal (#640 A2 / #646): the old `on_failure: EscalateToHuman` turned
    # ANY unrouted failure into the "accept → CommitFinal" gate, which under
    # --auto-approve shipped whatever the tree held — including nothing.
    # Agent nodes that a human can meaningfully override (FinalVerify) route
    # to EscalateToHuman explicitly; every mechanical tool node routes its
    # own failure to AbortRun below.
    on_failure: AbortRun

  agent Start
    label: Start

  agent Done
    label: Done

  # #646 (mirrors build_product's #640 A2 terminal): a mechanical workflow
  # step failed — a TOOL that exits 1, not a human gate, so it halts in every
  # mode (interactive, --auto-approve, --autopilot, --webhook); a gate's
  # unattended default would auto-advance. exit 1 + a single unconditional
  # edge to Done = strict-failure halt before Done, and the run ends `fail`.
  # Inline (not a sidecar) because it is a fixed three-line notice.
  tool AbortRun
    label: "Run aborted — a mechanical workflow step failed"
    timeout: 5s
    command:
      set -u
      echo "RUN ABORTED: a mechanical (non-agent) workflow step failed; nothing was applied or shipped."
      echo "The failing node and its stdout/stderr are in the activity log: run 'tracker diagnose' for the tail."
      echo "Fix the cause and start a new run: 'tracker -r' re-enters this terminal and cannot retry the failed step."
      exit 1

  # ─── Phase 1: Understand ───────────────────────────────────

  tool SetupWorkspace
    label: "Setup Workspace"
    timeout: 10s
    command_file: scripts/ask_and_execute/SetupWorkspace.sh

  human AskUser
    label: "What would you like done?"
    mode: freeform

  agent Explore
    label: "Explore Codebase"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/ask_and_execute/Explore.md

  agent WriteSpec
    label: "Write Implementation Spec"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/ask_and_execute/WriteSpec.md

  human ApproveSpec
    label: "Review the spec. Approve, refine, or reject."
    mode: freeform
    default: approve

  # ─── Phase 2: Isolated Implementation ──────────────────────

  tool SetupWorktrees
    label: "Create Git Worktrees"
    timeout: 30s
    command_file: scripts/ask_and_execute/SetupWorktrees.sh

  parallel ImplementParallel -> ImplementClaude, ImplementCodex, ImplementGemini

  agent ImplementClaude
    label: "Claude Implementation"
    model: claude-sonnet-5
    provider: anthropic
    working_dir: .ai/worktrees/claude
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/ask_and_execute/ImplementClaude.md

  agent ImplementCodex
    label: "Codex Implementation"
    model: gpt-5.5
    provider: openai
    working_dir: .ai/worktrees/codex
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/ask_and_execute/ImplementCodex.md

  agent ImplementGemini
    label: "Gemini Implementation"
    model: gemini-2.5-pro
    provider: gemini
    working_dir: .ai/worktrees/gemini
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/ask_and_execute/ImplementGemini.md

  fan_in ImplementJoin <- ImplementClaude, ImplementCodex, ImplementGemini

  # ─── Phase 3: Capture Evidence ─────────────────────────────

  tool CaptureAndTest
    label: "Capture Diffs & Run Tests"
    timeout: 300s
    command_file: scripts/ask_and_execute/CaptureAndTest.sh

  # #646 item 2: CaptureAndTest exits 1 only when NO candidate is usable
  # (every one red, empty or missing). That used to strict-fail into the
  # graph on_failure → "accept" gate → CommitFinal with nothing merged. Now a
  # human decides; the unattended default is abort (listed first — the
  # deterministic --auto-approve picks the first option and the LLM
  # autopilots the default), so no unattended run critiques garbage.
  human AllCandidatesRed
    label: "Every candidate is red — abort, or critique them anyway?"
    mode: freeform
    default: abort
    prompt:
      CaptureAndTest found no usable candidate: each of the three
      implementations either fails its tests, produced an empty diff, or has
      no worktree. The per-candidate result lines:

      ${ctx.tool_stdout}

      Evidence: .ai/candidates/<name>.diff and .ai/candidates/<name>.test.

      Options:
      - **abort** (default): stop the run. Nothing is merged; the candidate
        worktrees and impl/* branches are left in place for inspection.
      - **critique-anyway**: proceed to the cross-critique and selection with
        the red candidates. Only sensible when the failures are environmental
        (a missing toolchain in the worktrees) rather than real.

  # ─── Phase 4: Cross-Critique ───────────────────────────────

  agent CrossCritique
    label: "Cross-Critique All Implementations"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    fidelity: full
    prompt_file: prompts/ask_and_execute/CrossCritique.md

  # ─── Phase 5: Select & Apply ───────────────────────────────

  agent SelectWinner
    label: "Select Best Implementation"
    model: claude-opus-5
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/ask_and_execute/SelectWinner.md

  tool ApplyWinner
    label: "Apply Winner & Clean Up"
    timeout: 60s
    command_file: scripts/ask_and_execute/ApplyWinner.sh

  # ─── Phase 6: Verify ───────────────────────────────────────

  tool FinalBuild
    label: "Final Build & Test"
    timeout: 300s
    command_file: scripts/ask_and_execute/FinalBuild.sh

  agent FinalVerify
    label: "Verify Spec Compliance"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    fallback_target: EscalateToHuman
    prompt_file: prompts/ask_and_execute/FinalVerify.md
    auto_status: true

  human EscalateToHuman
    label: "Verification failed. Please review."
    mode: freeform

  agent CommitFinal
    label: "Final Commit"
    model: claude-sonnet-5
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/ask_and_execute/CommitFinal.md

  # ─── Edges ─────────────────────────────────────────────────

  edges
    Start -> SetupWorkspace
    SetupWorkspace -> AskUser
    AskUser -> Explore
    Explore -> WriteSpec
    WriteSpec -> ApproveSpec
    ApproveSpec -> SetupWorktrees  label: "approve"
    ApproveSpec -> WriteSpec  label: "refine"  restart: true
    ApproveSpec -> Done  label: "reject"
    # #640 A2 / #646: every mechanical tool node routes its own failure to
    # the AbortRun terminal — never to the accept gate.
    SetupWorkspace -> AbortRun  when ctx.outcome = fail
    SetupWorktrees -> AbortRun  when ctx.outcome = fail
    SetupWorktrees -> ImplementParallel
    ImplementJoin -> CaptureAndTest
    # #646 item 2: the script prints its routing marker LAST via printf with
    # no trailing newline, so `endswith` is exact (#640 A3): every candidate
    # usable → critique; none usable → the human gate; anything else (a
    # `set -e` abort before either marker) → the unconditional fallback to
    # the AbortRun TERMINAL (safe: not a loop target, never the accept gate).
    CaptureAndTest -> CrossCritique  when ctx.outcome = success and ctx.tool_stdout endswith candidates-captured
    CaptureAndTest -> AllCandidatesRed  when ctx.outcome = fail and ctx.tool_stdout endswith all-candidates-red
    CaptureAndTest -> AbortRun
    AllCandidatesRed -> AbortRun  label: "abort"
    AllCandidatesRed -> CrossCritique  label: "critique-anyway"
    CrossCritique -> SelectWinner
    SelectWinner -> ApplyWinner
    # #646 item 3: an unparseable/ambiguous WINNER line or a merge conflict
    # aborts (nothing merged) instead of reaching the accept gate.
    ApplyWinner -> AbortRun  when ctx.outcome = fail
    ApplyWinner -> FinalBuild
    FinalBuild -> FinalVerify  when ctx.outcome = success
    FinalBuild -> EscalateToHuman  when ctx.outcome = fail
    FinalBuild -> EscalateToHuman
    FinalVerify -> CommitFinal  when ctx.outcome = success
    FinalVerify -> EscalateToHuman  when ctx.outcome = fail
    FinalVerify -> EscalateToHuman
    # "accept" overrides the failed FinalVerify goal gate (#348 defect 2): the
    # run completes as validation_overridden. Audit-only; routing unchanged.
    EscalateToHuman -> CommitFinal  label: "accept"  override: true
    EscalateToHuman -> Done  label: "abandon"
    CommitFinal -> Done
    # exit 1 + a single unconditional edge => strict-failure halt before Done.
    AbortRun -> Done
