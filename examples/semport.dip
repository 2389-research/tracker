workflow Semport
  goal: "Build OmniAgentsSDK: port all files from openai-agents-python to Swift (Phase 1: port all, Phase 2: fix until builds)."
  start: Start
  exit: Exit

  defaults
    on_failure: Exit

  agent Start
    label: Start

  agent Exit
    label: Exit

  tool InitLedger
    label: "Init semport ledger"
    timeout: 60s
    command_file: scripts/semport/InitLedger.sh

  tool PickFile
    label: "Pick next file (exit 1 when done)"
    timeout: 60s
    command_file: scripts/semport/PickFile.sh

  tool LoadSource
    label: "Load Python source + existing Swift files"
    timeout: 60s
    command_file: scripts/semport/LoadSource.sh

  agent PortFile
    label: "Port to Swift (GPT-5.2)"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport/PortFile.md

  tool WriteFile
    label: "Write Swift file(s)"
    timeout: 60s
    command_file: scripts/semport/WriteFile.sh

  tool MarkPorted
    label: "Mark file as ported"
    timeout: 60s
    command_file: scripts/semport/MarkPorted.sh

  tool TryBuild
    label: "Try building OmniAgentsSDK"
    timeout: 60s
    command_file: scripts/semport/TryBuild.sh

  tool LoadErrors
    label: "Load build errors + source"
    timeout: 60s
    command_file: scripts/semport/LoadErrors.sh

  agent FixErrors
    label: "Fix build errors (Sonnet)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport/FixErrors.md

  tool WriteFixed
    label: "Write fixed files"
    timeout: 60s
    command_file: scripts/semport/WriteFixed.sh

  tool VerifyBuild
    label: "Verify build after fix"
    timeout: 60s
    command_file: scripts/semport/VerifyBuild.sh

  edges
    Start -> InitLedger
    InitLedger -> PickFile
    PickFile -> LoadSource
    PickFile -> TryBuild  when ctx.outcome = fail  label: "all ported"
    LoadSource -> PortFile
    PortFile -> WriteFile
    WriteFile -> MarkPorted
    MarkPorted -> PickFile  label: next  restart: true
    TryBuild -> Exit  when ctx.outcome = success  label: clean
    TryBuild -> LoadErrors  when ctx.outcome = fail  label: errors
    TryBuild -> Exit  label: "fallback to exit"
    LoadErrors -> FixErrors
    FixErrors -> WriteFixed
    WriteFixed -> VerifyBuild
    VerifyBuild -> Exit  when ctx.outcome = success  label: clean
    VerifyBuild -> LoadErrors  when ctx.outcome = fail  label: retry  restart: true
    VerifyBuild -> Exit  label: "fallback to exit"
