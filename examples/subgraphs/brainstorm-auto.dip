workflow brainstorm_auto
  goal: "Brainstorm a project design autonomously, answering questions with best judgment through iterative refinement until ready for a design brief."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    fidelity: summary:high
    # Engine default restart budget (5), made explicit so the loop bound is
    # visible (DIP134). Unchanged behavior.
    max_restarts: 5
    # Unrouted failures go to the fail-closed AbortRun sink below.
    on_failure: AbortRun

  agent Start
    label: Start

  agent Exit
    label: Exit

  agent AutoBrainstorm
    label: "Auto Brainstorm"
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: AutoBrainstorm
    prompt_file: prompts/brainstorm-auto/AutoBrainstorm.md
  tool CheckBrainstormDone
    label: "Brainstorm Complete?"
    timeout: 60s
    command_file: scripts/brainstorm-auto/CheckBrainstormDone.sh
  # Fail-closed sink for the graph-level on_failure route. A node that fails
  # with no route of its own lands here, exits 1, and the strict-failure rule
  # halts the run before Exit. The subgraph still ends `fail` (as it did when
  # the failing node halted directly), so the calling subgraph node fails too.
  # Start's `fail` edge is the explicit route here (dippin's coverage check
  # does not follow on_failure); success/fail are exhaustive, so Start's
  # success routing is unchanged.
  tool AbortRun
    label: "Subgraph aborted: a step failed"
    timeout: 5s
    command:
      echo "SUBGRAPH ABORTED: a step failed with no failure route of its own; run 'tracker diagnose' for its output."
      exit 1

  edges
    Start -> AutoBrainstorm  when ctx.outcome = success
    Start -> AbortRun  when ctx.outcome = fail  label: "start failed"
    AutoBrainstorm -> CheckBrainstormDone
    CheckBrainstormDone -> AutoBrainstorm  when ctx.tool_stdout = more_questions  label: "more questions"  restart: true
    CheckBrainstormDone -> Exit  when ctx.tool_stdout = done  label: "ready for design"
    CheckBrainstormDone -> AutoBrainstorm  label: fallback  restart: true
    AbortRun -> Exit
