workflow adaptive_ralph_stream
  goal: "Parameterized iterative implementation loop with velocity-aware model switching. Starts on sonnet for orientation, downshifts to haiku when cruising, escalates back to sonnet when stuck."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    fidelity: summary:high
    # Engine default restart budget (5), made explicit so the loop bound is
    # visible (DIP134). Unchanged behavior.
    max_restarts: 5
    # Unrouted failures go to the fail-closed AbortRun sink below.
    on_failure: AbortRun

  agent Start
    label: Start

  agent Exit
    label: Exit

  tool Setup
    label: "Setup Stream State"
    timeout: 1m
    command_file: scripts/adaptive-ralph-stream/Setup.sh
  tool IncrementCounter
    label: "Increment Iteration"
    timeout: 1m
    command_file: scripts/adaptive-ralph-stream/IncrementCounter.sh
  tool CheckVelocity
    label: "Check Velocity"
    timeout: 1m
    command_file: scripts/adaptive-ralph-stream/CheckVelocity.sh
  tool RecordProgress
    label: "Record Progress"
    timeout: 1m
    command_file: scripts/adaptive-ralph-stream/RecordProgress.sh
  agent RalphSonnet
    label: "Ralph (Sonnet)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    max_turns: 50
    max_retries: 3
    retry_target: RalphSonnet
    prompt_file: prompts/adaptive-ralph-stream/RalphSonnet.md
  agent RalphHaiku
    label: "Ralph (Haiku)"
    model: claude-haiku-4-5
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    max_turns: 50
    max_retries: 3
    retry_target: RalphHaiku
    prompt_file: prompts/adaptive-ralph-stream/RalphHaiku.md
  tool CheckCompletion
    label: "Check Completion"
    timeout: 1m
    command_file: scripts/adaptive-ralph-stream/CheckCompletion.sh
  tool CheckBudget
    label: "Check Iteration Budget"
    timeout: 1m
    command_file: scripts/adaptive-ralph-stream/CheckBudget.sh
  agent WrapUp
    label: "Wrap Up (Budget Exhausted)"
    model: claude-haiku-4-5
    provider: anthropic
    prompt_file: prompts/adaptive-ralph-stream/WrapUp.md
  # Fail-closed sink for the graph-level on_failure route. A node that fails
  # with no route of its own lands here, exits 1, and the strict-failure rule
  # halts the run before Exit. The subgraph still ends `fail` (as it did when
  # the failing node halted directly), so the calling subgraph node fails too.
  # Start's `fail` edge is the explicit route here (dippin's coverage check
  # does not follow on_failure); success/fail are exhaustive, so Start's
  # success routing is unchanged.
  tool AbortRun
    label: "Subgraph aborted: a step failed"
    timeout: 5s
    command:
      echo "SUBGRAPH ABORTED: a step failed with no failure route of its own; run 'tracker diagnose' for its output."
      exit 1

  edges
    Start -> Setup  when ctx.outcome = success
    Start -> AbortRun  when ctx.outcome = fail  label: "start failed"
    Setup -> IncrementCounter
    IncrementCounter -> CheckVelocity
    CheckVelocity -> RalphSonnet  when ctx.tool_stdout = orientation  label: "orientation phase"
    CheckVelocity -> RalphHaiku   when ctx.tool_stdout = cruising     label: "cruising — use haiku"
    CheckVelocity -> RalphSonnet  when ctx.tool_stdout = struggling   label: "stuck — use sonnet"
    CheckVelocity -> RalphSonnet  label: "fallback"
    RalphSonnet -> RecordProgress
    RalphHaiku -> RecordProgress
    RecordProgress -> CheckCompletion
    CheckCompletion -> Exit        when ctx.tool_stdout = complete  label: "stream done"
    CheckCompletion -> CheckBudget when ctx.tool_stdout = continue  label: "more work"
    CheckCompletion -> CheckBudget label: "fallback"
    CheckBudget -> IncrementCounter  when ctx.tool_stdout = budget_ok  label: "next iteration"  restart: true
    CheckBudget -> WrapUp  when ctx.tool_stdout = budget_exhausted  label: "out of iterations"
    CheckBudget -> WrapUp  label: "fallback"
    WrapUp -> Exit
    AbortRun -> Exit
