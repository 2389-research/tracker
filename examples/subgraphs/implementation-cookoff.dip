workflow implementation_cookoff
  goal: "Run three parallel implementations of a task (Opus, GPT, Gemini) using strict TDD, then pick the best one."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    fidelity: summary:high
    # Unrouted failures go to the fail-closed AbortRun sink below.
    on_failure: AbortRun

  agent Start
    label: Start

  agent Exit
    label: Exit

  parallel CookoffFanOut -> ImplementTaskOpus, ImplementTaskGPT, ImplementTaskGemini

  agent ImplementTaskOpus
    label: "Implement Task (Opus)"
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskOpus
    prompt_file: prompts/implementation-cookoff/ImplementTaskOpus.md
  agent ImplementTaskGPT
    label: "Implement Task (GPT-5.4)"
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskGPT
    prompt_file: prompts/implementation-cookoff/ImplementTaskGPT.md
  agent ImplementTaskGemini
    label: "Implement Task (Gemini)"
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskGemini
    prompt_file: prompts/implementation-cookoff/ImplementTaskGemini.md
  fan_in CookoffJoin <- ImplementTaskOpus, ImplementTaskGPT, ImplementTaskGemini

  agent PickWinner
    label: "Pick Winner"
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: PickWinner
    prompt_file: prompts/implementation-cookoff/PickWinner.md
  # Fail-closed sink for the graph-level on_failure route. A node that fails
  # with no route of its own lands here, exits 1, and the strict-failure rule
  # halts the run before Exit. The subgraph still ends `fail` (as it did when
  # the failing node halted directly), so the calling subgraph node fails too.
  # Start's `fail` edge is the explicit route here (dippin's coverage check
  # does not follow on_failure); success/fail are exhaustive, so Start's
  # success routing is unchanged.
  tool AbortRun
    label: "Subgraph aborted: a step failed"
    timeout: 5s
    command:
      echo "SUBGRAPH ABORTED: a step failed with no failure route of its own; run 'tracker diagnose' for its output."
      exit 1

  edges
    Start -> CookoffFanOut  when ctx.outcome = success
    Start -> AbortRun  when ctx.outcome = fail  label: "start failed"
    CookoffJoin -> PickWinner
    PickWinner -> Exit
    AbortRun -> Exit
