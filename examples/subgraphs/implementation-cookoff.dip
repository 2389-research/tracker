workflow implementation_cookoff
  goal: "Run three parallel implementations of a task (Opus, GPT, Gemini) using strict TDD, then pick the best one."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    fidelity: summary:high

  agent Start
    label: Start

  agent Exit
    label: Exit

  parallel CookoffFanOut -> ImplementTaskOpus, ImplementTaskGPT, ImplementTaskGemini

  agent ImplementTaskOpus
    label: "Implement Task (Opus)"
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskOpus
    prompt_file: prompts/implementation-cookoff/ImplementTaskOpus.md
  agent ImplementTaskGPT
    label: "Implement Task (GPT-5.4)"
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskGPT
    prompt_file: prompts/implementation-cookoff/ImplementTaskGPT.md
  agent ImplementTaskGemini
    label: "Implement Task (Gemini)"
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskGemini
    prompt_file: prompts/implementation-cookoff/ImplementTaskGemini.md
  fan_in CookoffJoin <- ImplementTaskOpus, ImplementTaskGPT, ImplementTaskGemini

  agent PickWinner
    label: "Pick Winner"
    fidelity: full
    goal_gate: true
    retry_target: PickWinner
    prompt_file: prompts/implementation-cookoff/PickWinner.md
  edges
    Start -> CookoffFanOut
    CookoffFanOut -> ImplementTaskOpus
    CookoffFanOut -> ImplementTaskGPT
    CookoffFanOut -> ImplementTaskGemini
    ImplementTaskOpus -> CookoffJoin
    ImplementTaskGPT -> CookoffJoin
    ImplementTaskGemini -> CookoffJoin
    CookoffJoin -> PickWinner
    PickWinner -> Exit
