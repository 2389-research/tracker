workflow brainstorm_human
  goal: "Brainstorm a project design interactively with a human, refining understanding through iterative Q&A until ready for a design brief."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    fidelity: summary:high

  agent Start
    label: Start

  agent Exit
    label: Exit

  human HumanBrainstorm
    label: "Brainstorm with Human"
    mode: freeform

  agent RefineUnderstanding
    label: "Refine Understanding"
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: RefineUnderstanding
    prompt_file: prompts/brainstorm-human/RefineUnderstanding.md
  tool CheckBrainstormDone
    label: "Brainstorm Complete?"
    timeout: 60s
    command_file: scripts/brainstorm-human/CheckBrainstormDone.sh
  edges
    Start -> HumanBrainstorm
    HumanBrainstorm -> RefineUnderstanding
    RefineUnderstanding -> CheckBrainstormDone
    CheckBrainstormDone -> HumanBrainstorm  when ctx.tool_stdout = more_questions  label: "more questions"  restart: true
    CheckBrainstormDone -> Exit  when ctx.tool_stdout = done  label: "ready for design"  weight: 2
    CheckBrainstormDone -> HumanBrainstorm  label: fallback  restart: true
