workflow dotpowers
  goal: "Given a project idea or spec, brainstorm the design with the human, plan, implement with TDD, review via multi-model consensus, and ship working software — with parallel design exploration (omakase) and parallel implementation (cookoff)."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    fidelity: summary:high
    max_restarts: 50
    on_failure: Exit

  agent Start
    label: Start
    model: claude-haiku-4-5
    provider: anthropic

  agent Exit
    label: Exit
    model: claude-haiku-4-5
    provider: anthropic

  tool CheckExistingPlans
    label: "Check Existing Plans"
    timeout: 1m
    command_file: scripts/test-kitchen/CheckExistingPlans.sh

  tool ArchiveOldPlans
    label: "Archive Old Plans"
    timeout: 1m
    command_file: scripts/test-kitchen/ArchiveOldPlans.sh

  agent ExploreIdea
    label: "Explore Idea"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: ExploreIdea
    prompt_file: prompts/test-kitchen/ExploreIdea.md

  parallel OmakaseFanOut -> DesignExploreOpus, DesignExploreGPT, DesignExploreGemini

  agent DesignExploreOpus
    label: "Design Explore (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: DesignExploreOpus
    prompt_file: prompts/test-kitchen/DesignExploreOpus.md

  agent DesignExploreGPT
    label: "Design Explore (GPT-5.4)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: DesignExploreGPT
    prompt_file: prompts/test-kitchen/DesignExploreGPT.md

  agent DesignExploreGemini
    label: "Design Explore (Gemini)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: DesignExploreGemini
    prompt_file: prompts/test-kitchen/DesignExploreGemini.md

  fan_in OmakaseJoin <- DesignExploreOpus, DesignExploreGPT, DesignExploreGemini

  agent ConsolidateDesigns
    label: "Consolidate Designs"
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: ConsolidateDesigns
    prompt_file: prompts/test-kitchen/ConsolidateDesigns.md

  human ApproveDesign
    label: "Approve Design Brief?"
    mode: yes_no

  human DesignFeedback
    label: "Design Feedback"
    mode: freeform

  agent IncorporateDesignFeedback
    label: "Incorporate Design Feedback"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: IncorporateDesignFeedback
    prompt_file: prompts/test-kitchen/IncorporateDesignFeedback.md

  agent CommitBrief
    label: "Commit Brief"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CommitBrief
    prompt_file: prompts/test-kitchen/CommitBrief.md

  agent DraftPlan
    label: "Draft Plan (GPT-5.2)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: HumanHelp
    prompt_file: prompts/test-kitchen/DraftPlan.md

  tool ValidatePlanFormat
    label: "Validate Plan Format"
    timeout: 1m
    command_file: scripts/test-kitchen/ValidatePlanFormat.sh

  agent AuditPlanSpec
    label: "Audit Plan vs Spec (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: PatchPlan
    prompt_file: prompts/test-kitchen/AuditPlanSpec.md

  agent PatchPlan
    label: "Patch Plan (GPT-5.2)"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: HumanHelp
    prompt_file: prompts/test-kitchen/PatchPlan.md

  agent CommitPlan
    label: "Commit Plan"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CommitPlan
    prompt_file: prompts/test-kitchen/CommitPlan.md

  agent SetupProject
    label: "Setup Project"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: SetupProject
    prompt_file: prompts/test-kitchen/SetupProject.md

  tool VerifyBaseline
    label: "Verify Baseline"
    timeout: 2m
    command_file: scripts/test-kitchen/VerifyBaseline.sh

  tool PickNextTask
    label: "Pick Next Task"
    timeout: 1m
    command_file: scripts/test-kitchen/PickNextTask.sh

  parallel CookoffFanOut -> ImplementTaskOpus, ImplementTaskGPT, ImplementTaskGemini

  agent ImplementTaskOpus
    label: "Implement Task (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskOpus
    prompt_file: prompts/test-kitchen/ImplementTaskOpus.md

  agent ImplementTaskGPT
    label: "Implement Task (GPT-5.4)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskGPT
    prompt_file: prompts/test-kitchen/ImplementTaskGPT.md

  agent ImplementTaskGemini
    label: "Implement Task (Gemini)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskGemini
    prompt_file: prompts/test-kitchen/ImplementTaskGemini.md

  fan_in CookoffJoin <- ImplementTaskOpus, ImplementTaskGPT, ImplementTaskGemini

  agent PickWinner
    label: "Pick Cookoff Winner"
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: PickWinner
    prompt_file: prompts/test-kitchen/PickWinner.md

  tool CheckImplementerReady
    label: "Implementer Ready?"
    timeout: 1m
    command_file: scripts/test-kitchen/CheckImplementerReady.sh

  human ImplementerQuestion
    label: "Implementer Has a Question"
    mode: freeform

  agent SpecReview
    label: "Spec Compliance Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: PickWinner
    prompt_file: prompts/test-kitchen/SpecReview.md

  agent QualityReview
    label: "Code Quality Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: PickWinner
    prompt_file: prompts/test-kitchen/QualityReview.md

  tool CheckImplementBudget
    label: "Check Implement Budget"
    timeout: 1m
    command_file: scripts/test-kitchen/CheckImplementBudget.sh

  tool MarkTaskComplete
    label: "Mark Task Complete"
    timeout: 1m
    command_file: scripts/test-kitchen/MarkTaskComplete.sh

  agent DebugInvestigate
    label: "Debug Investigation"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ReplanTask
    prompt_file: prompts/test-kitchen/DebugInvestigate.md

  agent ReplanTask
    label: "Replan Task"
    model: claude-sonnet-4-6
    provider: anthropic
    max_retries: 1
    retry_target: HumanHelp
    prompt_file: prompts/test-kitchen/ReplanTask.md

  human HumanHelp
    label: "Need Human Help"
    mode: freeform

  agent ResumeAfterHelp
    label: "Resume After Help"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: ResumeAfterHelp
    prompt_file: prompts/test-kitchen/ResumeAfterHelp.md

  tool ValidateBuild
    label: "Validate Full Build"
    timeout: 2m
    command_file: scripts/test-kitchen/ValidateBuild.sh

  parallel ReviewFanOut -> FinalReviewOpus, FinalReviewGPT, FinalReviewGemini

  agent FinalReviewOpus
    label: "Final Review (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: summary:high
    goal_gate: true
    max_retries: 3
    retry_target: FinalReviewOpus
    prompt_file: prompts/test-kitchen/FinalReviewOpus.md

  agent FinalReviewGPT
    label: "Final Review (GPT-5.4)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: summary:high
    goal_gate: true
    max_retries: 3
    retry_target: FinalReviewGPT
    prompt_file: prompts/test-kitchen/FinalReviewGPT.md

  agent FinalReviewGemini
    label: "Final Review (Gemini)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: summary:high
    goal_gate: true
    max_retries: 3
    retry_target: FinalReviewGemini
    prompt_file: prompts/test-kitchen/FinalReviewGemini.md

  fan_in ReviewsJoin <- FinalReviewOpus, FinalReviewGPT, FinalReviewGemini

  parallel CritiqueFanOut -> CritiqueOpusOnGPT, CritiqueOpusOnGemini, CritiqueGPTOnOpus, CritiqueGPTOnGemini, CritiqueGeminiOnOpus, CritiqueGeminiOnGPT

  agent CritiqueOpusOnGPT
    label: "Opus Critiques GPT Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueOpusOnGPT
    prompt_file: prompts/test-kitchen/CritiqueOpusOnGPT.md

  agent CritiqueOpusOnGemini
    label: "Opus Critiques Gemini Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueOpusOnGemini
    prompt_file: prompts/test-kitchen/CritiqueOpusOnGemini.md

  agent CritiqueGPTOnOpus
    label: "GPT Critiques Opus Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueGPTOnOpus
    prompt_file: prompts/test-kitchen/CritiqueGPTOnOpus.md

  agent CritiqueGPTOnGemini
    label: "GPT Critiques Gemini Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueGPTOnGemini
    prompt_file: prompts/test-kitchen/CritiqueGPTOnGemini.md

  agent CritiqueGeminiOnOpus
    label: "Gemini Critiques Opus Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueGeminiOnOpus
    prompt_file: prompts/test-kitchen/CritiqueGeminiOnOpus.md

  agent CritiqueGeminiOnGPT
    label: "Gemini Critiques GPT Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueGeminiOnGPT
    prompt_file: prompts/test-kitchen/CritiqueGeminiOnGPT.md

  fan_in CritiquesJoin <- CritiqueOpusOnGPT, CritiqueOpusOnGemini, CritiqueGPTOnOpus, CritiqueGPTOnGemini, CritiqueGeminiOnOpus, CritiqueGeminiOnGPT

  agent ReviewConsensus
    label: "Review Consensus"
    goal_gate: true
    max_retries: 1
    retry_target: PickWinner
    prompt_file: prompts/test-kitchen/ReviewConsensus.md

  tool CheckReworkBudget
    label: "Check Rework Budget"
    timeout: 1m
    command_file: scripts/test-kitchen/CheckReworkBudget.sh

  agent FailureSummary
    label: "Failure Summary"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: FailureSummary
    prompt_file: prompts/test-kitchen/FailureSummary.md

  tool VerifyTestsFinal
    label: "Final Test Verification"
    timeout: 2m
    command_file: scripts/test-kitchen/VerifyTestsFinal.sh

  agent CreatePR
    label: "Create Pull Request"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CreatePR
    prompt_file: prompts/test-kitchen/CreatePR.md

  edges
    Start -> CheckExistingPlans
    CheckExistingPlans -> PickNextTask  when ctx.tool_stdout = resume  label: "resume — plan exists"
    CheckExistingPlans -> ArchiveOldPlans  when ctx.tool_stdout = fresh  label: "fresh start"
    CheckExistingPlans -> ArchiveOldPlans  label: fallback
    ArchiveOldPlans -> ExploreIdea
    ExploreIdea -> OmakaseFanOut
    OmakaseJoin -> ConsolidateDesigns
    ConsolidateDesigns -> ApproveDesign
    ApproveDesign -> CommitBrief  when ctx.outcome = success  label: "[Y] Approve"
    ApproveDesign -> DesignFeedback  when ctx.outcome = fail  label: "[N] Revise"
    ApproveDesign -> DesignFeedback  label: fallback
    DesignFeedback -> IncorporateDesignFeedback
    IncorporateDesignFeedback -> ApproveDesign  loop
    CommitBrief -> DraftPlan
    DraftPlan -> ValidatePlanFormat
    ValidatePlanFormat -> AuditPlanSpec  when ctx.tool_stdout = format_ok  label: "format ok"
    ValidatePlanFormat -> HumanHelp  when ctx.tool_stdout = fail_retries_exhausted  label: "plan loop exhausted"
    ValidatePlanFormat -> DraftPlan  when ctx.tool_stdout != format_ok and ctx.tool_stdout != fail_retries_exhausted  label: "format fail"  loop
    ValidatePlanFormat -> HumanHelp  label: fallback
    AuditPlanSpec -> CommitPlan  on success  label: "plan approved"
    AuditPlanSpec -> PatchPlan  on fail  label: "gaps found"
    AuditPlanSpec -> PatchPlan  label: fallback
    PatchPlan -> ValidatePlanFormat  loop
    CommitPlan -> SetupProject
    SetupProject -> VerifyBaseline
    VerifyBaseline -> PickNextTask
    PickNextTask -> CookoffFanOut  when ctx.tool_stdout != all_complete and ctx.tool_stdout != no_tasks_found  label: "has task"
    PickNextTask -> ValidateBuild  when ctx.tool_stdout = all_complete  label: "all done"
    PickNextTask -> HumanHelp  when ctx.tool_stdout = no_tasks_found  label: "no tasks in plan"
    PickNextTask -> HumanHelp  label: fallback
    CookoffJoin -> PickWinner
    PickWinner -> CheckImplementerReady
    CheckImplementerReady -> SpecReview  when ctx.tool_stdout = ready  label: "ready to review"
    CheckImplementerReady -> ImplementerQuestion  when ctx.tool_stdout = has_question  label: "has question"
    CheckImplementerReady -> ImplementerQuestion  label: fallback
    ImplementerQuestion -> CookoffFanOut  loop
    SpecReview -> QualityReview  on success  label: "spec pass"
    SpecReview -> CheckImplementBudget  on fail  label: "spec fail"
    SpecReview -> CheckImplementBudget  label: fallback
    QualityReview -> MarkTaskComplete  on success  label: "quality pass"
    QualityReview -> CheckImplementBudget  on fail  label: "quality fail"
    QualityReview -> MarkTaskComplete  label: fallback
    CheckImplementBudget -> CookoffFanOut  when ctx.tool_stdout = budget_ok  label: "retry ok"  loop
    CheckImplementBudget -> HumanHelp  when ctx.tool_stdout = budget_exhausted  label: "too many attempts"
    CheckImplementBudget -> HumanHelp  label: fallback
    MarkTaskComplete -> PickNextTask  loop
    PickWinner -> DebugInvestigate  on fail  label: "retries exhausted"
    DebugInvestigate -> CookoffFanOut  on success  label: "fixed, re-verify"  loop
    DebugInvestigate -> ReplanTask  on fail  label: "can't fix"
    DebugInvestigate -> ReplanTask  label: fallback
    ReplanTask -> PickNextTask  on success  label: replanned  loop
    ReplanTask -> HumanHelp  on fail  label: stuck
    ReplanTask -> HumanHelp  label: fallback
    HumanHelp -> ResumeAfterHelp
    ResumeAfterHelp -> PickNextTask  loop
    ValidateBuild -> ReviewFanOut  when ctx.outcome = success  label: "build pass"
    ValidateBuild -> CheckReworkBudget  when ctx.outcome = fail  label: "build fail"
    ValidateBuild -> FailureSummary  label: fallback
    ReviewsJoin -> CritiqueFanOut
    CritiquesJoin -> ReviewConsensus
    ReviewConsensus -> VerifyTestsFinal  on success  label: pass
    ReviewConsensus -> CheckReworkBudget  on retry  label: rework
    ReviewConsensus -> FailureSummary  on fail  label: blocked
    ReviewConsensus -> VerifyTestsFinal  label: fallback
    CheckReworkBudget -> CookoffFanOut  when ctx.tool_stdout = budget_ok  label: "rework ok"  loop
    CheckReworkBudget -> FailureSummary  when ctx.tool_stdout = budget_exhausted  label: "rework budget exhausted"
    CheckReworkBudget -> FailureSummary  label: fallback
    FailureSummary -> Exit
    VerifyTestsFinal -> CreatePR  when ctx.outcome = success  label: "tests pass"
    VerifyTestsFinal -> CheckReworkBudget  when ctx.outcome = fail  label: "tests fail"
    VerifyTestsFinal -> FailureSummary  label: fallback
    CreatePR -> FailureSummary  on fail  label: "PR failed"
    CreatePR -> Exit  on success  label: shipped
    CreatePR -> Exit  label: fallback
