workflow HumanGateShowcase
  goal: "Exercise every human gate mode: freeform input, binary choice, multi-choice, default selection, and chained gates."
  start: Start
  exit: Exit

  defaults
    fidelity: summary:medium
    on_failure: Exit

  agent Start
    label: Start

  agent Exit
    label: Exit

  human FreeformGate
    label: "Tell me something interesting."
    mode: freeform

  agent EchoFreeform
    label: "Echo Freeform Response"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/EchoFreeform.md

  human BinaryGate
    label: "Do you want to continue to the fun part?"

  agent YesPath
    label: "Enthusiasm Check"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/YesPath.md

  agent NoPath
    label: "Early Exit Summary"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/NoPath.md

  human MultiChoiceGate
    label: "Pick your favorite color."

  agent RedPath
    label: "Red Commentary"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/RedPath.md

  agent BluePath
    label: "Blue Commentary"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/BluePath.md

  agent GreenPath
    label: "Green Commentary"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/GreenPath.md

  agent WildcardPath
    label: "Wildcard Commentary"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/WildcardPath.md

  human DefaultGate
    label: "How spicy do you like your food?"

  agent MildPath
    label: "Mild Reaction"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/MildPath.md

  agent MediumPath
    label: "Medium Reaction"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/MediumPath.md

  agent HotPath
    label: "Hot Reaction"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: low
    prompt_file: prompts/human_gate_showcase/HotPath.md

  human FinalFreeform
    label: "Any last words before we wrap up?"
    mode: freeform

  agent FinalSummary
    label: "Final Summary"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/human_gate_showcase/FinalSummary.md

  edges
    Start -> FreeformGate
    FreeformGate -> EchoFreeform
    EchoFreeform -> BinaryGate
    BinaryGate -> YesPath  label: "[Y] Yes"
    BinaryGate -> NoPath  label: "[N] No"
    NoPath -> Exit
    YesPath -> MultiChoiceGate
    MultiChoiceGate -> RedPath  label: "[R] Red"
    MultiChoiceGate -> BluePath  label: "[B] Blue"
    MultiChoiceGate -> GreenPath  label: "[G] Green"
    MultiChoiceGate -> WildcardPath  label: "[W] Wildcard"
    RedPath -> DefaultGate
    BluePath -> DefaultGate
    GreenPath -> DefaultGate
    WildcardPath -> DefaultGate
    DefaultGate -> MildPath  label: "[L] Mild"
    DefaultGate -> MediumPath  label: "[M] Medium"
    DefaultGate -> HotPath  label: "[H] Hot"
    MildPath -> FinalFreeform
    MediumPath -> FinalFreeform
    HotPath -> FinalFreeform
    FinalFreeform -> FinalSummary
    FinalSummary -> Exit
