workflow dotpowers
  goal: "Given a project idea or spec, explore the design autonomously, plan, implement with TDD, review via multi-model consensus, and ship working software with parallel design exploration (omakase), parallel implementation (cookoff), and real-dependency scenario validation — running fully headless with no human intervention."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    fidelity: summary:high
    max_restarts: 50
    on_failure: Exit

  agent Start
    label: Start
    model: claude-haiku-4-5
    provider: anthropic

  agent Exit
    label: Exit
    model: claude-haiku-4-5
    provider: anthropic

  tool CheckExistingPlans
    label: "Check Existing Plans"
    timeout: 1m
    command_file: scripts/kitchen-sink/CheckExistingPlans.sh

  tool ArchiveOldPlans
    label: "Archive Old Plans"
    timeout: 1m
    command_file: scripts/kitchen-sink/ArchiveOldPlans.sh

  agent ExploreIdea
    label: "Explore Idea"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: ExploreIdea
    prompt_file: prompts/kitchen-sink/ExploreIdea.md

  parallel OmakaseFanOut -> DesignExploreOpus, DesignExploreGPT, DesignExploreGemini

  agent DesignExploreOpus
    label: "Design Explore (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: DesignExploreOpus
    prompt_file: prompts/kitchen-sink/DesignExploreOpus.md

  agent DesignExploreGPT
    label: "Design Explore (GPT-5.4)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: DesignExploreGPT
    prompt_file: prompts/kitchen-sink/DesignExploreGPT.md

  agent DesignExploreGemini
    label: "Design Explore (Gemini)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: DesignExploreGemini
    prompt_file: prompts/kitchen-sink/DesignExploreGemini.md

  fan_in OmakaseJoin <- DesignExploreOpus, DesignExploreGPT, DesignExploreGemini

  agent ConsolidateDesigns
    label: "Consolidate Designs"
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: ConsolidateDesigns
    prompt_file: prompts/kitchen-sink/ConsolidateDesigns.md

  agent CommitBrief
    label: "Commit Brief"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CommitBrief
    prompt_file: prompts/kitchen-sink/CommitBrief.md

  agent DraftPlan
    label: "Draft Plan (GPT-5.2)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: AutoRecover
    prompt_file: prompts/kitchen-sink/DraftPlan.md

  tool ValidatePlanFormat
    label: "Validate Plan Format"
    timeout: 1m
    command_file: scripts/kitchen-sink/ValidatePlanFormat.sh

  agent AuditPlanSpec
    label: "Audit Plan vs Spec (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: PatchPlan
    prompt_file: prompts/kitchen-sink/AuditPlanSpec.md

  agent PatchPlan
    label: "Patch Plan (GPT-5.2)"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: AutoRecover
    prompt_file: prompts/kitchen-sink/PatchPlan.md

  agent CommitPlan
    label: "Commit Plan"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CommitPlan
    prompt_file: prompts/kitchen-sink/CommitPlan.md

  agent SetupProject
    label: "Setup Project"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: SetupProject
    prompt_file: prompts/kitchen-sink/SetupProject.md

  tool VerifyBaseline
    label: "Verify Baseline"
    timeout: 2m
    command_file: scripts/kitchen-sink/VerifyBaseline.sh

  tool PickNextTask
    label: "Pick Next Task"
    timeout: 1m
    command_file: scripts/kitchen-sink/PickNextTask.sh

  parallel CookoffFanOut -> ImplementTaskOpus, ImplementTaskGPT, ImplementTaskGemini

  agent ImplementTaskOpus
    label: "Implement Task (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskOpus
    prompt_file: prompts/kitchen-sink/ImplementTaskOpus.md

  agent ImplementTaskGPT
    label: "Implement Task (GPT-5.4)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskGPT
    prompt_file: prompts/kitchen-sink/ImplementTaskGPT.md

  agent ImplementTaskGemini
    label: "Implement Task (Gemini)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTaskGemini
    prompt_file: prompts/kitchen-sink/ImplementTaskGemini.md

  fan_in CookoffJoin <- ImplementTaskOpus, ImplementTaskGPT, ImplementTaskGemini

  agent PickWinner
    label: "Pick Winner"
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: PickWinner
    prompt_file: prompts/kitchen-sink/PickWinner.md

  agent SpecReview
    label: "Spec Compliance Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: PickWinner
    prompt_file: prompts/kitchen-sink/SpecReview.md

  agent QualityReview
    label: "Code Quality Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: PickWinner
    prompt_file: prompts/kitchen-sink/QualityReview.md

  tool CheckImplementBudget
    label: "Check Implement Budget"
    timeout: 1m
    command_file: scripts/kitchen-sink/CheckImplementBudget.sh

  tool MarkTaskComplete
    label: "Mark Task Complete"
    timeout: 1m
    command_file: scripts/kitchen-sink/MarkTaskComplete.sh

  agent DebugInvestigate
    label: "Debug Investigation"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ReplanTask
    prompt_file: prompts/kitchen-sink/DebugInvestigate.md

  agent ReplanTask
    label: "Replan Task"
    model: claude-sonnet-4-6
    provider: anthropic
    max_retries: 1
    retry_target: AutoRecover
    prompt_file: prompts/kitchen-sink/ReplanTask.md

  agent AutoRecover
    label: "Auto Recover"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: AutoRecover
    prompt_file: prompts/kitchen-sink/AutoRecover.md

  agent WriteScenarios
    label: "Write Scenarios"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: WriteScenarios
    prompt_file: prompts/kitchen-sink/WriteScenarios.md

  tool RunScenarios
    label: "Run Scenarios"
    timeout: 2m
    command_file: scripts/kitchen-sink/RunScenarios.sh

  agent FixScenarioFailures
    label: "Fix Scenario Failures"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: FixScenarioFailures
    prompt_file: prompts/kitchen-sink/FixScenarioFailures.md

  agent ExtractScenarioPatterns
    label: "Extract Scenario Patterns"
    goal_gate: true
    max_retries: 3
    retry_target: ExtractScenarioPatterns
    prompt_file: prompts/kitchen-sink/ExtractScenarioPatterns.md

  tool ValidateBuild
    label: "Validate Full Build"
    timeout: 2m
    command_file: scripts/kitchen-sink/ValidateBuild.sh

  parallel ReviewFanOut -> FinalReviewOpus, FinalReviewGPT, FinalReviewGemini

  agent FinalReviewOpus
    label: "Final Review (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: summary:high
    goal_gate: true
    max_retries: 3
    retry_target: FinalReviewOpus
    prompt_file: prompts/kitchen-sink/FinalReviewOpus.md

  agent FinalReviewGPT
    label: "Final Review (GPT-5.4)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: summary:high
    goal_gate: true
    max_retries: 3
    retry_target: FinalReviewGPT
    prompt_file: prompts/kitchen-sink/FinalReviewGPT.md

  agent FinalReviewGemini
    label: "Final Review (Gemini)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: summary:high
    goal_gate: true
    max_retries: 3
    retry_target: FinalReviewGemini
    prompt_file: prompts/kitchen-sink/FinalReviewGemini.md

  fan_in ReviewsJoin <- FinalReviewOpus, FinalReviewGPT, FinalReviewGemini

  parallel CritiqueFanOut -> CritiqueOpusOnGPT, CritiqueOpusOnGemini, CritiqueGPTOnOpus, CritiqueGPTOnGemini, CritiqueGeminiOnOpus, CritiqueGeminiOnGPT

  agent CritiqueOpusOnGPT
    label: "Opus Critiques GPT Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueOpusOnGPT
    prompt_file: prompts/kitchen-sink/CritiqueOpusOnGPT.md

  agent CritiqueOpusOnGemini
    label: "Opus Critiques Gemini Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueOpusOnGemini
    prompt_file: prompts/kitchen-sink/CritiqueOpusOnGemini.md

  agent CritiqueGPTOnOpus
    label: "GPT Critiques Opus Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueGPTOnOpus
    prompt_file: prompts/kitchen-sink/CritiqueGPTOnOpus.md

  agent CritiqueGPTOnGemini
    label: "GPT Critiques Gemini Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueGPTOnGemini
    prompt_file: prompts/kitchen-sink/CritiqueGPTOnGemini.md

  agent CritiqueGeminiOnOpus
    label: "Gemini Critiques Opus Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueGeminiOnOpus
    prompt_file: prompts/kitchen-sink/CritiqueGeminiOnOpus.md

  agent CritiqueGeminiOnGPT
    label: "Gemini Critiques GPT Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CritiqueGeminiOnGPT
    prompt_file: prompts/kitchen-sink/CritiqueGeminiOnGPT.md

  fan_in CritiquesJoin <- CritiqueOpusOnGPT, CritiqueOpusOnGemini, CritiqueGPTOnOpus, CritiqueGPTOnGemini, CritiqueGeminiOnOpus, CritiqueGeminiOnGPT

  agent ReviewConsensus
    label: "Review Consensus"
    goal_gate: true
    max_retries: 1
    retry_target: PickWinner
    prompt_file: prompts/kitchen-sink/ReviewConsensus.md

  tool CheckReworkBudget
    label: "Check Rework Budget"
    timeout: 1m
    command_file: scripts/kitchen-sink/CheckReworkBudget.sh

  agent FailureSummary
    label: "Failure Summary"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: FailureSummary
    prompt_file: prompts/kitchen-sink/FailureSummary.md

  tool VerifyTestsFinal
    label: "Final Test Verification"
    timeout: 2m
    command_file: scripts/kitchen-sink/VerifyTestsFinal.sh

  agent CreatePR
    label: "Create Pull Request"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CreatePR
    prompt_file: prompts/kitchen-sink/CreatePR.md

  edges
    Start -> CheckExistingPlans
    CheckExistingPlans -> PickNextTask  when ctx.tool_stdout = resume  label: "resume — plan exists"
    CheckExistingPlans -> ArchiveOldPlans  when ctx.tool_stdout = fresh  label: "fresh start"
    CheckExistingPlans -> ArchiveOldPlans  label: fallback
    ArchiveOldPlans -> ExploreIdea
    ExploreIdea -> OmakaseFanOut
    OmakaseJoin -> ConsolidateDesigns
    ConsolidateDesigns -> CommitBrief
    CommitBrief -> DraftPlan
    DraftPlan -> ValidatePlanFormat
    ValidatePlanFormat -> AuditPlanSpec  when ctx.tool_stdout = format_ok  label: "format ok"
    ValidatePlanFormat -> AutoRecover  when ctx.tool_stdout = fail_retries_exhausted  label: "plan loop exhausted"
    ValidatePlanFormat -> DraftPlan  when ctx.tool_stdout != format_ok and ctx.tool_stdout != fail_retries_exhausted  label: "format fail"  loop
    ValidatePlanFormat -> AutoRecover  label: fallback
    AuditPlanSpec -> CommitPlan  on success  label: "plan approved"
    AuditPlanSpec -> PatchPlan  on fail  label: "gaps found"
    AuditPlanSpec -> PatchPlan  label: fallback
    PatchPlan -> ValidatePlanFormat  loop
    CommitPlan -> SetupProject
    SetupProject -> VerifyBaseline
    VerifyBaseline -> PickNextTask
    PickNextTask -> CookoffFanOut  when ctx.tool_stdout != all_complete and ctx.tool_stdout != no_tasks_found  label: "has task"
    PickNextTask -> WriteScenarios  when ctx.tool_stdout = all_complete  label: "all done"
    PickNextTask -> AutoRecover  when ctx.tool_stdout = no_tasks_found  label: "no tasks in plan"
    PickNextTask -> AutoRecover  label: fallback
    CookoffJoin -> PickWinner
    PickWinner -> SpecReview  on success  label: "winner picked"
    SpecReview -> QualityReview  on success  label: "spec pass"
    SpecReview -> CheckImplementBudget  on fail  label: "spec fail"
    SpecReview -> CheckImplementBudget  label: fallback
    QualityReview -> MarkTaskComplete  on success  label: "quality pass"
    QualityReview -> CheckImplementBudget  on fail  label: "quality fail"
    QualityReview -> MarkTaskComplete  label: fallback
    CheckImplementBudget -> CookoffFanOut  when ctx.tool_stdout = budget_ok  label: "retry ok"  loop
    CheckImplementBudget -> AutoRecover  when ctx.tool_stdout = budget_exhausted  label: "too many attempts"
    CheckImplementBudget -> AutoRecover  label: fallback
    MarkTaskComplete -> PickNextTask  loop
    PickWinner -> DebugInvestigate  on fail  label: "retries exhausted"
    PickWinner -> DebugInvestigate  label: fallback
    DebugInvestigate -> CookoffFanOut  on success  label: "fixed, re-verify"  loop
    DebugInvestigate -> ReplanTask  on fail  label: "can't fix"
    DebugInvestigate -> ReplanTask  label: fallback
    ReplanTask -> PickNextTask  on success  label: replanned  loop
    ReplanTask -> AutoRecover  on fail  label: stuck
    ReplanTask -> AutoRecover  label: fallback
    AutoRecover -> PickNextTask  on success  label: recovered  loop
    AutoRecover -> FailureSummary  on fail  label: unrecoverable
    AutoRecover -> FailureSummary  label: fallback
    WriteScenarios -> RunScenarios
    RunScenarios -> ExtractScenarioPatterns  when ctx.tool_stdout = scenarios_pass  label: "scenarios pass"
    RunScenarios -> FixScenarioFailures  when ctx.tool_stdout != scenarios_pass  label: "scenarios fail"
    RunScenarios -> FixScenarioFailures  label: fallback
    FixScenarioFailures -> RunScenarios  loop
    ExtractScenarioPatterns -> ValidateBuild
    ValidateBuild -> ReviewFanOut  when ctx.outcome = success  label: "build pass"
    ValidateBuild -> CheckReworkBudget  when ctx.outcome = fail  label: "build fail"
    ValidateBuild -> FailureSummary  label: fallback
    ReviewsJoin -> CritiqueFanOut
    CritiquesJoin -> ReviewConsensus
    ReviewConsensus -> VerifyTestsFinal  on success  label: pass
    ReviewConsensus -> CheckReworkBudget  on retry  label: rework
    ReviewConsensus -> FailureSummary  on fail  label: blocked
    ReviewConsensus -> VerifyTestsFinal  label: fallback
    CheckReworkBudget -> CookoffFanOut  when ctx.tool_stdout = budget_ok  label: "rework ok"  loop
    CheckReworkBudget -> FailureSummary  when ctx.tool_stdout = budget_exhausted  label: "rework budget exhausted"
    CheckReworkBudget -> FailureSummary  label: fallback
    FailureSummary -> Exit
    VerifyTestsFinal -> CreatePR  when ctx.outcome = success  label: "tests pass"
    VerifyTestsFinal -> CheckReworkBudget  when ctx.outcome = fail  label: "tests fail"
    VerifyTestsFinal -> FailureSummary  label: fallback
    CreatePR -> FailureSummary  on fail  label: "PR failed"
    CreatePR -> Exit  on success  label: shipped
    CreatePR -> Exit  label: fallback
