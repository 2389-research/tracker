workflow dotpowers_auto
  goal: "Given a project idea or spec, brainstorm the design autonomously, plan, implement with TDD, review via multi-model consensus, and ship working software — running fully headless with no human intervention."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    max_restarts: 50
    fidelity: summary:high
    on_failure: Exit

  agent Start
    label: Start
    model: claude-haiku-4-5
    provider: anthropic

  agent Exit
    label: Exit
    model: claude-haiku-4-5
    provider: anthropic

  tool CheckExistingPlans
    label: "Check Existing Plans"
    timeout: 1m
    command_file: scripts/dotpowers-auto/CheckExistingPlans.sh

  tool ArchiveOldPlans
    label: "Archive Old Plans"
    timeout: 1m
    command_file: scripts/dotpowers-auto/ArchiveOldPlans.sh

  agent ExploreIdea
    label: "Explore Idea"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ExploreIdea
    prompt_file: prompts/dotpowers-auto/ExploreIdea.md

  agent AutoBrainstorm
    label: "Auto Brainstorm"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: AutoBrainstorm
    prompt_file: prompts/dotpowers-auto/AutoBrainstorm.md

  tool CheckBrainstormDone
    label: "Brainstorm Complete?"
    timeout: 1m
    command_file: scripts/dotpowers-auto/CheckBrainstormDone.sh

  agent WriteDesignBrief
    label: "Write Design Brief"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: WriteDesignBrief
    prompt_file: prompts/dotpowers-auto/WriteDesignBrief.md

  agent CommitBrief
    label: "Commit Brief"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: CommitBrief
    prompt_file: prompts/dotpowers-auto/CommitBrief.md

  agent DraftPlan
    label: "Draft Plan (GPT-5.2)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: AutoRecover
    prompt_file: prompts/dotpowers-auto/DraftPlan.md

  tool ValidatePlanFormat
    label: "Validate Plan Format"
    timeout: 1m
    command_file: scripts/dotpowers-auto/ValidatePlanFormat.sh

  agent AuditPlanSpec
    label: "Audit Plan vs Spec (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: PatchPlan
    prompt_file: prompts/dotpowers-auto/AuditPlanSpec.md

  agent PatchPlan
    label: "Patch Plan (GPT-5.2)"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: AutoRecover
    prompt_file: prompts/dotpowers-auto/PatchPlan.md

  agent CommitPlan
    label: "Commit Plan"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: CommitPlan
    prompt_file: prompts/dotpowers-auto/CommitPlan.md

  agent SetupProject
    label: "Setup Project"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: SetupProject
    prompt_file: prompts/dotpowers-auto/SetupProject.md

  tool VerifyBaseline
    label: "Verify Baseline"
    timeout: 2m
    command_file: scripts/dotpowers-auto/VerifyBaseline.sh

  tool PickNextTask
    label: "Pick Next Task"
    timeout: 1m
    command_file: scripts/dotpowers-auto/PickNextTask.sh

  agent ImplementTask
    label: "Implement Task (TDD)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTask
    prompt_file: prompts/dotpowers-auto/ImplementTask.md

  agent SpecReview
    label: "Spec Compliance Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTask
    prompt_file: prompts/dotpowers-auto/SpecReview.md

  agent QualityReview
    label: "Code Quality Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTask
    prompt_file: prompts/dotpowers-auto/QualityReview.md

  tool CheckImplementBudget
    label: "Check Implement Budget"
    timeout: 1m
    command_file: scripts/dotpowers-auto/CheckImplementBudget.sh

  tool MarkTaskComplete
    label: "Mark Task Complete"
    timeout: 1m
    command_file: scripts/dotpowers-auto/MarkTaskComplete.sh

  agent DebugInvestigate
    label: "Debug Investigation"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ReplanTask
    prompt_file: prompts/dotpowers-auto/DebugInvestigate.md

  agent ReplanTask
    label: "Replan Task"
    model: claude-sonnet-4-6
    provider: anthropic
    max_retries: 1
    retry_target: AutoRecover
    prompt_file: prompts/dotpowers-auto/ReplanTask.md

  agent AutoRecover
    label: "Auto Recover"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: AutoRecover
    prompt_file: prompts/dotpowers-auto/AutoRecover.md

  tool ValidateBuild
    label: "Validate Full Build"
    timeout: 2m
    command_file: scripts/dotpowers-auto/ValidateBuild.sh

  parallel ReviewFanOut -> FinalReviewOpus, FinalReviewGPT, FinalReviewGemini

  agent FinalReviewOpus
    label: "Final Review (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: summary:high
    goal_gate: true
    max_retries: 2
    retry_target: FinalReviewOpus
    prompt_file: prompts/dotpowers-auto/FinalReviewOpus.md

  agent FinalReviewGPT
    label: "Final Review (GPT-5.4)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: summary:high
    goal_gate: true
    max_retries: 2
    retry_target: FinalReviewGPT
    prompt_file: prompts/dotpowers-auto/FinalReviewGPT.md

  agent FinalReviewGemini
    label: "Final Review (Gemini)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: summary:high
    goal_gate: true
    max_retries: 2
    retry_target: FinalReviewGemini
    prompt_file: prompts/dotpowers-auto/FinalReviewGemini.md

  fan_in ReviewsJoin <- FinalReviewOpus, FinalReviewGPT, FinalReviewGemini

  parallel CritiqueFanOut -> CritiqueOpusOnGPT, CritiqueOpusOnGemini, CritiqueGPTOnOpus, CritiqueGPTOnGemini, CritiqueGeminiOnOpus, CritiqueGeminiOnGPT

  agent CritiqueOpusOnGPT
    label: "Opus Critiques GPT Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: CritiqueOpusOnGPT
    prompt_file: prompts/dotpowers-auto/CritiqueOpusOnGPT.md

  agent CritiqueOpusOnGemini
    label: "Opus Critiques Gemini Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: CritiqueOpusOnGemini
    prompt_file: prompts/dotpowers-auto/CritiqueOpusOnGemini.md

  agent CritiqueGPTOnOpus
    label: "GPT Critiques Opus Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: CritiqueGPTOnOpus
    prompt_file: prompts/dotpowers-auto/CritiqueGPTOnOpus.md

  agent CritiqueGPTOnGemini
    label: "GPT Critiques Gemini Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: CritiqueGPTOnGemini
    prompt_file: prompts/dotpowers-auto/CritiqueGPTOnGemini.md

  agent CritiqueGeminiOnOpus
    label: "Gemini Critiques Opus Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: CritiqueGeminiOnOpus
    prompt_file: prompts/dotpowers-auto/CritiqueGeminiOnOpus.md

  agent CritiqueGeminiOnGPT
    label: "Gemini Critiques GPT Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: CritiqueGeminiOnGPT
    prompt_file: prompts/dotpowers-auto/CritiqueGeminiOnGPT.md

  fan_in CritiquesJoin <- CritiqueOpusOnGPT, CritiqueOpusOnGemini, CritiqueGPTOnOpus, CritiqueGPTOnGemini, CritiqueGeminiOnOpus, CritiqueGeminiOnGPT

  agent ReviewConsensus
    label: "Review Consensus"
    goal_gate: true
    max_retries: 1
    retry_target: ImplementTask
    prompt_file: prompts/dotpowers-auto/ReviewConsensus.md

  tool CheckReworkBudget
    label: "Check Rework Budget"
    timeout: 1m
    command_file: scripts/dotpowers-auto/CheckReworkBudget.sh

  agent FailureSummary
    label: "Failure Summary"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: FailureSummary
    prompt_file: prompts/dotpowers-auto/FailureSummary.md

  tool VerifyTestsFinal
    label: "Final Test Verification"
    timeout: 2m
    command_file: scripts/dotpowers-auto/VerifyTestsFinal.sh

  agent CreatePR
    label: "Create Pull Request"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 2
    retry_target: CreatePR
    prompt_file: prompts/dotpowers-auto/CreatePR.md

  edges
    Start -> CheckExistingPlans
    CheckExistingPlans -> PickNextTask  when ctx.tool_stdout = resume  label: "resume — plan exists"
    CheckExistingPlans -> ArchiveOldPlans  when ctx.tool_stdout = fresh  label: "fresh start"
    CheckExistingPlans -> ArchiveOldPlans  label: fallback
    ArchiveOldPlans -> ExploreIdea
    ExploreIdea -> AutoBrainstorm
    AutoBrainstorm -> CheckBrainstormDone
    CheckBrainstormDone -> AutoBrainstorm  when ctx.tool_stdout = more_questions  label: "more questions"  loop
    CheckBrainstormDone -> WriteDesignBrief  when ctx.tool_stdout = done  label: "ready for design"
    CheckBrainstormDone -> AutoBrainstorm  label: fallback  loop
    WriteDesignBrief -> CommitBrief
    CommitBrief -> DraftPlan
    DraftPlan -> ValidatePlanFormat
    ValidatePlanFormat -> AuditPlanSpec  when ctx.tool_stdout = format_ok  label: "format ok"
    ValidatePlanFormat -> AutoRecover  when ctx.tool_stdout = fail_retries_exhausted  label: "plan loop exhausted"
    ValidatePlanFormat -> DraftPlan  when ctx.tool_stdout != format_ok and ctx.tool_stdout != fail_retries_exhausted  label: "format fail"  loop
    ValidatePlanFormat -> AutoRecover  label: fallback
    AuditPlanSpec -> CommitPlan  on success  label: "plan approved"
    AuditPlanSpec -> PatchPlan  on fail  label: "gaps found"
    AuditPlanSpec -> PatchPlan  label: fallback
    PatchPlan -> ValidatePlanFormat  loop
    CommitPlan -> SetupProject
    SetupProject -> VerifyBaseline
    VerifyBaseline -> PickNextTask
    PickNextTask -> ImplementTask  when ctx.tool_stdout != all_complete and ctx.tool_stdout != no_tasks_found  label: "has task"
    PickNextTask -> ValidateBuild  when ctx.tool_stdout = all_complete  label: "all done"
    PickNextTask -> AutoRecover  when ctx.tool_stdout = no_tasks_found  label: "no tasks in plan"
    PickNextTask -> AutoRecover  label: fallback
    ImplementTask -> SpecReview
    SpecReview -> QualityReview  on success  label: "spec pass"
    SpecReview -> CheckImplementBudget  on fail  label: "spec fail"
    SpecReview -> CheckImplementBudget  label: fallback
    QualityReview -> MarkTaskComplete  on success  label: "quality pass"
    QualityReview -> CheckImplementBudget  on fail  label: "quality fail"
    QualityReview -> MarkTaskComplete  label: fallback
    CheckImplementBudget -> ImplementTask  when ctx.tool_stdout = budget_ok  label: "retry ok"  loop
    CheckImplementBudget -> AutoRecover  when ctx.tool_stdout = budget_exhausted  label: "too many attempts"
    CheckImplementBudget -> AutoRecover  label: fallback
    MarkTaskComplete -> PickNextTask  loop
    ImplementTask -> DebugInvestigate  on fail  label: "retries exhausted"
    DebugInvestigate -> ImplementTask  on success  label: "fixed, re-verify"  loop
    DebugInvestigate -> ReplanTask  on fail  label: "can't fix"
    DebugInvestigate -> ReplanTask  label: fallback
    ReplanTask -> PickNextTask  on success  label: replanned  loop
    ReplanTask -> AutoRecover  on fail  label: stuck
    ReplanTask -> AutoRecover  label: fallback
    AutoRecover -> PickNextTask  on success  label: recovered  loop
    AutoRecover -> FailureSummary  on fail  label: unrecoverable
    AutoRecover -> FailureSummary  label: fallback
    ValidateBuild -> ReviewFanOut  when ctx.outcome = success  label: "build pass"
    ValidateBuild -> CheckReworkBudget  when ctx.outcome = fail  label: "build fail"
    ValidateBuild -> FailureSummary  label: fallback
    ReviewsJoin -> CritiqueFanOut
    CritiquesJoin -> ReviewConsensus
    ReviewConsensus -> VerifyTestsFinal  on success  label: pass
    ReviewConsensus -> CheckReworkBudget  on retry  label: rework
    ReviewConsensus -> FailureSummary  on fail  label: blocked
    ReviewConsensus -> VerifyTestsFinal  label: fallback
    CheckReworkBudget -> ImplementTask  when ctx.tool_stdout = budget_ok  label: "rework ok"  loop
    CheckReworkBudget -> FailureSummary  when ctx.tool_stdout = budget_exhausted  label: "rework budget exhausted"
    CheckReworkBudget -> FailureSummary  label: fallback
    FailureSummary -> Exit
    VerifyTestsFinal -> CreatePR  when ctx.outcome = success  label: "tests pass"
    VerifyTestsFinal -> CheckReworkBudget  when ctx.outcome = fail  label: "tests fail"
    VerifyTestsFinal -> FailureSummary  label: fallback
    CreatePR -> FailureSummary  on fail  label: "PR failed"
    CreatePR -> Exit  on success  label: shipped
    CreatePR -> Exit  label: fallback
