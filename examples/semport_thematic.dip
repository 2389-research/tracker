workflow SemportThematic
  goal: "Port $source_ref into $target_name via evolving thematic checklist and iterative implementation/validation."
  start: Start
  exit: Exit

  defaults
    max_retries: 5
    max_restarts: 20
    on_failure: Exit

  agent Start
    label: Start

  agent Exit
    label: Exit

  tool EnsureWorkspace
    label: "Ensure semport workspace files"
    timeout: 1m
    command_file: scripts/semport_thematic/EnsureWorkspace.sh

  parallel PlanParallel -> PlanGPT, PlanOpus, PlanGemini

  agent PlanGPT
    label: "Plan Themes (GPT-5.2)"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport_thematic/PlanGPT.md

  agent PlanOpus
    label: "Plan Themes (Opus-4.6)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport_thematic/PlanOpus.md

  agent PlanGemini
    label: "Plan Themes (Gemini 3.1 Pro)"
    model: gemini-3.1-pro-preview
    provider: gemini
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport_thematic/PlanGemini.md

  fan_in PlanJoin <- PlanGPT, PlanOpus, PlanGemini

  agent ConsolidatePlan
    label: "Consolidate Plan Into Spec (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport_thematic/ConsolidatePlan.md

  agent ImplementSlice
    label: "Implement Next Checklist Slice (GPT-5.3 Codex)"
    model: gpt-5.3-codex
    provider: openai
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport_thematic/ImplementSlice.md

  tool BuildGate
    label: "Build gate (must pass)"
    timeout: 1m
    command_file: scripts/semport_thematic/BuildGate.sh

  parallel ValidateParallel -> ValidateGPT, ValidateOpus, ValidateGemini

  agent ValidateGPT
    label: "Validate (GPT-5.2)"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport_thematic/ValidateGPT.md

  agent ValidateOpus
    label: "Validate (Opus-4.6)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport_thematic/ValidateOpus.md

  agent ValidateGemini
    label: "Validate (Gemini 3.1 Pro)"
    model: gemini-3.1-pro-preview
    provider: gemini
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport_thematic/ValidateGemini.md

  fan_in ValidateJoin <- ValidateGPT, ValidateOpus, ValidateGemini

  agent ConsolidateValidation
    label: "Consolidate Validation + Update Spec (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    auto_status: true
    prompt_file: prompts/semport_thematic/ConsolidateValidation.md

  tool CheckCompletion
    label: "Check if checklist fully complete"
    timeout: 1m
    command_file: scripts/semport_thematic/CheckCompletion.sh

  edges
    Start -> EnsureWorkspace
    EnsureWorkspace -> PlanParallel
    PlanJoin -> ConsolidatePlan
    ConsolidatePlan -> ImplementSlice
    ImplementSlice -> BuildGate
    BuildGate -> ValidateParallel  when ctx.outcome = success  label: build_passed
    BuildGate -> PlanParallel  when ctx.outcome = fail  label: build_failed_replan  loop
    BuildGate -> ValidateParallel  label: "fallback to validate"
    ValidateJoin -> ConsolidateValidation
    ConsolidateValidation -> CheckCompletion
    CheckCompletion -> Exit  when ctx.outcome = success  label: all_checked_and_validated
    CheckCompletion -> PlanParallel  when ctx.outcome = fail  label: needs_more_porting  loop
    CheckCompletion -> Exit  label: "fallback to exit"
