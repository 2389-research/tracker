workflow ConsensusTask
  goal: "Produce a validated multi-model implementation plan and review consensus for the requested task."
  start: Start
  exit: Exit

  defaults
    max_retries: 3
    fidelity: truncate
    max_restarts: 5
    on_failure: Exit

  agent Start
    label: Start

  agent Exit
    label: Exit

  agent RefineDoD
    label: "Refine DoD Gate"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task/RefineDoD.md

  parallel DoDParallel -> DefineDoDGemini, DefineDoDGPT, DefineDoDOpus

  agent DefineDoDGemini
    label: "Refine DoD (Gemini)"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/consensus_task/DefineDoDGemini.md

  agent DefineDoDGPT
    label: "Refine DoD (GPT-5.2)"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/consensus_task/DefineDoDGPT.md

  agent DefineDoDOpus
    label: "Refine DoD (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task/DefineDoDOpus.md

  fan_in DoDJoin <- DefineDoDGemini, DefineDoDGPT, DefineDoDOpus

  agent ConsolidateDoD
    label: "Consolidate DoD"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task/ConsolidateDoD.md

  parallel PlanParallel -> PlanGemini, PlanGPT, PlanOpus

  agent PlanGemini
    label: "Plan (Gemini)"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/consensus_task/PlanGemini.md

  agent PlanGPT
    label: "Plan (GPT-5.2)"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/consensus_task/PlanGPT.md

  agent PlanOpus
    label: "Plan (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task/PlanOpus.md

  fan_in PlanJoin <- PlanGemini, PlanGPT, PlanOpus

  agent DebateConsolidate
    label: "Debate and Consolidate Plans"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task/DebateConsolidate.md

  agent Implement
    label: Implement
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task/Implement.md

  agent VerifyOutputs
    label: "Verify Outputs"
    model: claude-haiku-4-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task/VerifyOutputs.md

  parallel ReviewParallel -> ReviewGemini, ReviewGPT, ReviewOpus

  agent ReviewGemini
    label: "Review (Gemini)"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/consensus_task/ReviewGemini.md

  agent ReviewGPT
    label: "Review (GPT-5.2)"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/consensus_task/ReviewGPT.md

  agent ReviewOpus
    label: "Review (Opus)"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task/ReviewOpus.md

  fan_in ReviewJoin <- ReviewGemini, ReviewGPT, ReviewOpus

  agent ReviewConsensus
    label: "Review Consensus"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    max_retries: 1
    retry_target: Implement
    prompt_file: prompts/consensus_task/ReviewConsensus.md

  agent Postmortem
    label: Postmortem
    model: claude-haiku-4-5
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/consensus_task/Postmortem.md

  edges
    Start -> RefineDoD
    RefineDoD -> DoDParallel
    DoDJoin -> ConsolidateDoD
    ConsolidateDoD -> PlanParallel
    PlanJoin -> DebateConsolidate
    DebateConsolidate -> Implement
    Implement -> VerifyOutputs
    VerifyOutputs -> ReviewParallel
    ReviewJoin -> ReviewConsensus
    ReviewConsensus -> Exit  on success  label: pass
    ReviewConsensus -> Postmortem  on retry  label: retry
    ReviewConsensus -> Exit
    Postmortem -> PlanParallel  when ctx.internal.loop_restart_count = 0  label: retry_once  loop
    Postmortem -> Exit  when ctx.internal.loop_restart_count != 0  label: stop_after_retry
    Postmortem -> Exit  label: "fallback to exit"
