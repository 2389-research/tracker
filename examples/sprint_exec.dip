workflow SprintExec
  goal: "Execute the next incomplete sprint from .ai/ledger.tsv through implementation, validation, multi-model review, and completion."
  start: Start
  exit: Exit

  defaults
    fidelity: summary:medium
    on_failure: FailureSummary

  agent Start
    label: Start

  agent Exit
    label: Exit

  tool EnsureLedger
    label: "Ensure Ledger"
    timeout: 1m
    command_file: scripts/sprint_exec/EnsureLedger.sh

  agent FindNextSprint
    label: "Find Next Sprint"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/FindNextSprint.md

  tool SetCurrentSprint
    label: "Set Current Sprint"
    timeout: 1m
    command_file: scripts/sprint_exec/SetCurrentSprint.sh

  agent ReadSprint
    label: "Read Sprint"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/ReadSprint.md

  tool MarkInProgress
    label: "Mark In Progress"
    timeout: 1m
    command_file: scripts/sprint_exec/MarkInProgress.sh

  agent ImplementSprint
    label: "Implement Sprint"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    fidelity: summary:high
    prompt_file: prompts/sprint_exec/ImplementSprint.md

  tool ValidateBuild
    label: "Validate Build and Tests"
    timeout: 1m
    command_file: scripts/sprint_exec/ValidateBuild.sh

  agent CommitSprintWork
    label: "Commit Sprint Work"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/CommitSprintWork.md

  parallel ReviewParallel -> ReviewClaude, ReviewCodex, ReviewGemini

  agent ReviewClaude
    label: "Claude Review"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/ReviewClaude.md

  agent ReviewCodex
    label: "Codex Review"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/ReviewCodex.md

  agent ReviewGemini
    label: "Gemini Review"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/ReviewGemini.md

  fan_in ReviewsJoin <- ReviewClaude, ReviewCodex, ReviewGemini

  parallel CritiquesParallel -> CritiqueClaudeOnCodex, CritiqueClaudeOnGemini, CritiqueCodexOnClaude, CritiqueCodexOnGemini, CritiqueGeminiOnClaude, CritiqueGeminiOnCodex

  agent CritiqueClaudeOnCodex
    label: "Claude Critique of Codex Review"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/CritiqueClaudeOnCodex.md

  agent CritiqueClaudeOnGemini
    label: "Claude Critique of Gemini Review"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/CritiqueClaudeOnGemini.md

  agent CritiqueCodexOnClaude
    label: "Codex Critique of Claude Review"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/CritiqueCodexOnClaude.md

  agent CritiqueCodexOnGemini
    label: "Codex Critique of Gemini Review"
    model: gpt-5.2
    provider: openai
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/CritiqueCodexOnGemini.md

  agent CritiqueGeminiOnClaude
    label: "Gemini Critique of Claude Review"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/CritiqueGeminiOnClaude.md

  agent CritiqueGeminiOnCodex
    label: "Gemini Critique of Codex Review"
    model: gemini-3-flash-preview
    provider: gemini
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/CritiqueGeminiOnCodex.md

  fan_in CritiquesJoin <- CritiqueClaudeOnCodex, CritiqueClaudeOnGemini, CritiqueCodexOnClaude, CritiqueCodexOnGemini, CritiqueGeminiOnClaude, CritiqueGeminiOnCodex

  agent ReviewAnalysis
    label: "Review Analysis"
    model: claude-opus-4-6
    provider: anthropic
    reasoning_effort: high
    goal_gate: true
    max_retries: 3
    retry_target: ImplementSprint
    prompt_file: prompts/sprint_exec/ReviewAnalysis.md

  tool CompleteSprint
    label: "Complete Sprint"
    timeout: 1m
    command_file: scripts/sprint_exec/CompleteSprint.sh

  agent FailureSummary
    label: "Failure Summary"
    model: claude-sonnet-4-6
    provider: anthropic
    reasoning_effort: high
    prompt_file: prompts/sprint_exec/FailureSummary.md

  edges
    Start -> EnsureLedger
    EnsureLedger -> FindNextSprint
    FindNextSprint -> SetCurrentSprint
    SetCurrentSprint -> ReadSprint
    ReadSprint -> MarkInProgress
    MarkInProgress -> ImplementSprint
    ImplementSprint -> ValidateBuild
    ValidateBuild -> CommitSprintWork  when ctx.outcome = success  label: validated
    ValidateBuild -> ImplementSprint  when ctx.outcome = fail  label: fix_validation  loop
    ValidateBuild -> CommitSprintWork
    CommitSprintWork -> ReviewParallel
    ReviewsJoin -> CritiquesParallel
    CritiquesJoin -> ReviewAnalysis
    ReviewAnalysis -> CompleteSprint  on success  label: pass
    ReviewAnalysis -> ImplementSprint  on retry  label: rework  loop
    ReviewAnalysis -> FailureSummary  on fail  label: fail
    ReviewAnalysis -> FailureSummary
    CompleteSprint -> Exit
    FailureSummary -> Exit
