workflow dotpowers_simple
  goal: "Given a project idea or spec, brainstorm the design with the human, plan, implement with TDD, review with streamlined reviews and minimal ceremony, and ship working software."
  start: Start
  exit: Exit

  defaults
    max_retries: 2
    max_restarts: 50
    fidelity: summary:high
    on_failure: Exit

  agent Start
    label: Start
    model: claude-haiku-4-5
    provider: anthropic

  agent Exit
    label: Exit
    model: claude-haiku-4-5
    provider: anthropic

  tool CheckExistingPlans
    label: "Check Existing Plans"
    timeout: 1m
    command_file: scripts/dotpowers-simple/CheckExistingPlans.sh

  tool ArchiveOldPlans
    label: "Archive Old Plans"
    timeout: 1m
    command_file: scripts/dotpowers-simple/ArchiveOldPlans.sh

  agent ExploreIdea
    label: "Explore Idea"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: ExploreIdea
    prompt_file: prompts/dotpowers-simple/ExploreIdea.md

  human HumanBrainstorm
    label: "Brainstorm with Human"
    mode: freeform

  agent RefineUnderstanding
    label: "Refine Understanding"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: RefineUnderstanding
    prompt_file: prompts/dotpowers-simple/RefineUnderstanding.md

  tool CheckBrainstormDone
    label: "Brainstorm Complete?"
    timeout: 1m
    command_file: scripts/dotpowers-simple/CheckBrainstormDone.sh

  agent WriteDesignBrief
    label: "Write Design Brief"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: WriteDesignBrief
    prompt_file: prompts/dotpowers-simple/WriteDesignBrief.md

  human ApproveDesign
    label: "Approve Design Brief?"
    mode: yes_no

  human DesignFeedback
    label: "Design Feedback"
    mode: freeform

  agent IncorporateDesignFeedback
    label: "Incorporate Design Feedback"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: IncorporateDesignFeedback
    prompt_file: prompts/dotpowers-simple/IncorporateDesignFeedback.md

  agent CommitBrief
    label: "Commit Brief"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CommitBrief
    prompt_file: prompts/dotpowers-simple/CommitBrief.md

  agent DraftPlan
    label: "Draft Plan (GPT-5.2)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: HumanHelp
    prompt_file: prompts/dotpowers-simple/DraftPlan.md

  tool ValidatePlanFormat
    label: "Validate Plan Format"
    timeout: 1m
    command_file: scripts/dotpowers-simple/ValidatePlanFormat.sh

  agent CommitPlan
    label: "Commit Plan"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CommitPlan
    prompt_file: prompts/dotpowers-simple/CommitPlan.md

  agent SetupProject
    label: "Setup Project"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: SetupProject
    prompt_file: prompts/dotpowers-simple/SetupProject.md

  tool VerifyBaseline
    label: "Verify Baseline"
    timeout: 2m
    command_file: scripts/dotpowers-simple/VerifyBaseline.sh

  tool PickNextTask
    label: "Pick Next Task"
    timeout: 1m
    command_file: scripts/dotpowers-simple/PickNextTask.sh

  agent ImplementTask
    label: "Implement Task (TDD)"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ImplementTask
    prompt_file: prompts/dotpowers-simple/ImplementTask.md

  agent SpecReview
    label: "Spec Compliance Review"
    model: claude-sonnet-4-6
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: ImplementTask
    prompt_file: prompts/dotpowers-simple/SpecReview.md

  tool CheckImplementBudget
    label: "Check Implement Budget"
    timeout: 1m
    command_file: scripts/dotpowers-simple/CheckImplementBudget.sh

  tool CheckImplementerReady
    label: "Implementer Ready?"
    timeout: 1m
    command_file: scripts/dotpowers-simple/CheckImplementerReady.sh

  human ImplementerQuestion
    label: "Implementer Has a Question"
    mode: freeform

  tool MarkTaskComplete
    label: "Mark Task Complete"
    timeout: 1m
    command_file: scripts/dotpowers-simple/MarkTaskComplete.sh

  agent DebugInvestigate
    label: "Debug Investigation"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 2
    retry_target: ReplanTask
    prompt_file: prompts/dotpowers-simple/DebugInvestigate.md

  agent ReplanTask
    label: "Replan Task"
    model: claude-sonnet-4-6
    provider: anthropic
    max_retries: 1
    retry_target: HumanHelp
    prompt_file: prompts/dotpowers-simple/ReplanTask.md

  human HumanHelp
    label: "Need Human Help"
    mode: freeform

  agent ResumeAfterHelp
    label: "Resume After Help"
    model: claude-sonnet-4-6
    provider: anthropic
    fidelity: full
    goal_gate: true
    max_retries: 3
    retry_target: ResumeAfterHelp
    prompt_file: prompts/dotpowers-simple/ResumeAfterHelp.md

  tool ValidateBuild
    label: "Validate Full Build"
    timeout: 2m
    command_file: scripts/dotpowers-simple/ValidateBuild.sh

  agent FinalReview
    label: "Final Review (Opus)"
    fidelity: summary:high
    goal_gate: true
    max_retries: 3
    retry_target: FinalReview
    prompt_file: prompts/dotpowers-simple/FinalReview.md

  tool CheckReworkBudget
    label: "Check Rework Budget"
    timeout: 1m
    command_file: scripts/dotpowers-simple/CheckReworkBudget.sh

  agent FailureSummary
    label: "Failure Summary"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: FailureSummary
    prompt_file: prompts/dotpowers-simple/FailureSummary.md

  tool VerifyTestsFinal
    label: "Final Test Verification"
    timeout: 2m
    command_file: scripts/dotpowers-simple/VerifyTestsFinal.sh

  agent CreatePR
    label: "Create Pull Request"
    model: claude-haiku-4-5
    provider: anthropic
    goal_gate: true
    max_retries: 3
    retry_target: CreatePR
    prompt_file: prompts/dotpowers-simple/CreatePR.md

  edges
    Start -> CheckExistingPlans
    CheckExistingPlans -> PickNextTask  when ctx.tool_stdout = resume  label: "resume — plan exists"
    CheckExistingPlans -> ArchiveOldPlans  when ctx.tool_stdout = fresh  label: "fresh start"
    CheckExistingPlans -> ArchiveOldPlans  label: fallback
    ArchiveOldPlans -> ExploreIdea
    ExploreIdea -> HumanBrainstorm
    HumanBrainstorm -> RefineUnderstanding
    RefineUnderstanding -> CheckBrainstormDone
    CheckBrainstormDone -> HumanBrainstorm  when ctx.tool_stdout = more_questions  label: "more questions"  loop
    CheckBrainstormDone -> WriteDesignBrief  when ctx.tool_stdout = done  label: "ready for design"
    CheckBrainstormDone -> HumanBrainstorm  label: fallback  loop
    WriteDesignBrief -> ApproveDesign
    ApproveDesign -> CommitBrief  when ctx.outcome = success  label: "[Y] Approve"
    ApproveDesign -> DesignFeedback  when ctx.outcome = fail  label: "[N] Revise"
    ApproveDesign -> DesignFeedback  label: fallback
    DesignFeedback -> IncorporateDesignFeedback
    IncorporateDesignFeedback -> ApproveDesign  loop
    CommitBrief -> DraftPlan
    DraftPlan -> ValidatePlanFormat
    ValidatePlanFormat -> CommitPlan  when ctx.tool_stdout = format_ok  label: "format ok"
    ValidatePlanFormat -> HumanHelp  when ctx.tool_stdout = fail_retries_exhausted  label: "plan loop exhausted"
    ValidatePlanFormat -> DraftPlan  when ctx.tool_stdout != format_ok and ctx.tool_stdout != fail_retries_exhausted  label: "format fail"  loop
    ValidatePlanFormat -> HumanHelp  label: fallback
    CommitPlan -> SetupProject
    SetupProject -> VerifyBaseline
    VerifyBaseline -> PickNextTask
    PickNextTask -> ImplementTask  when ctx.tool_stdout != all_complete and ctx.tool_stdout != no_tasks_found  label: "has task"
    PickNextTask -> ValidateBuild  when ctx.tool_stdout = all_complete  label: "all done"
    PickNextTask -> HumanHelp  when ctx.tool_stdout = no_tasks_found  label: "no tasks in plan"
    PickNextTask -> HumanHelp  label: fallback
    ImplementTask -> CheckImplementerReady
    CheckImplementerReady -> SpecReview  when ctx.tool_stdout = ready  label: "ready to review"
    CheckImplementerReady -> ImplementerQuestion  when ctx.tool_stdout = has_question  label: "has question"
    CheckImplementerReady -> ImplementerQuestion  label: fallback
    ImplementerQuestion -> ImplementTask  loop
    SpecReview -> MarkTaskComplete  on success  label: "spec pass"
    SpecReview -> CheckImplementBudget  on fail  label: "spec fail"
    SpecReview -> CheckImplementBudget  label: fallback
    CheckImplementBudget -> ImplementTask  when ctx.tool_stdout = budget_ok  label: "retry ok"  loop
    CheckImplementBudget -> HumanHelp  when ctx.tool_stdout = budget_exhausted  label: "too many attempts"
    CheckImplementBudget -> HumanHelp  label: fallback
    MarkTaskComplete -> PickNextTask  loop
    ImplementTask -> DebugInvestigate  on fail  label: "retries exhausted"
    DebugInvestigate -> ImplementTask  on success  label: "fixed, re-verify"  loop
    DebugInvestigate -> ReplanTask  on fail  label: "can't fix"
    DebugInvestigate -> ReplanTask  label: fallback
    ReplanTask -> PickNextTask  on success  label: replanned  loop
    ReplanTask -> HumanHelp  on fail  label: stuck
    ReplanTask -> HumanHelp  label: fallback
    HumanHelp -> ResumeAfterHelp
    ResumeAfterHelp -> PickNextTask  loop
    ValidateBuild -> FinalReview  when ctx.outcome = success  label: "build pass"
    ValidateBuild -> CheckReworkBudget  when ctx.outcome = fail  label: "build fail"
    ValidateBuild -> FailureSummary  label: fallback
    FinalReview -> VerifyTestsFinal  on success  label: pass
    FinalReview -> CheckReworkBudget  on retry  label: rework
    FinalReview -> FailureSummary  on fail  label: blocked
    FinalReview -> VerifyTestsFinal  label: fallback
    CheckReworkBudget -> ImplementTask  when ctx.tool_stdout = budget_ok  label: "rework ok"  loop
    CheckReworkBudget -> FailureSummary  when ctx.tool_stdout = budget_exhausted  label: "rework budget exhausted"
    CheckReworkBudget -> FailureSummary  label: fallback
    FailureSummary -> Exit
    VerifyTestsFinal -> CreatePR  when ctx.outcome = success  label: "tests pass"
    VerifyTestsFinal -> CheckReworkBudget  when ctx.outcome = fail  label: "tests fail"
    VerifyTestsFinal -> FailureSummary  label: fallback
    CreatePR -> FailureSummary  on fail  label: "PR failed"
    CreatePR -> Exit  on success  label: shipped
    CreatePR -> Exit  label: fallback
