#!/usr/bin/env bash
# ABOUTME: Pre-commit hook enforcing quality gates.
# ABOUTME: Install with: ln -sf ../../.pre-commit .git/hooks/pre-commit
set -euo pipefail

# git exports GIT_DIR/GIT_INDEX_FILE (pointing at THIS repo's gitdir and the
# in-progress commit index) into hook child processes. The test gates below run
# `go test ./...`, and several tests create throwaway git repos with
# `git init`/`add`/`commit` in temp dirs — git honors the inherited GIT_DIR /
# GIT_INDEX_FILE over their `-C tmpdir`, so without stripping these the test
# suite writes to (and truncates) the real staging index mid-commit. Run the
# test gates through `gotest` which drops the git-internal pointers; the hook's
# own git commands (e.g. the staged-files diff) keep the real env.
gotest() { env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
  -u GIT_OBJECT_DIRECTORY -u GIT_COMMON_DIR go test "$@"; }

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

pass() { printf "${GREEN}✓${NC} %s\n" "$1"; }
fail() { printf "${RED}✗${NC} %s\n" "$1"; exit 1; }
warn() { printf "${YELLOW}!${NC} %s\n" "$1"; }

echo "═══ Pre-commit Quality Gates ═══"

# 1. Format check
echo ""
echo "--- Format ---"
UNFORMATTED=$(gofmt -l . 2>&1 | grep -v vendor | grep -v '\.claude/' || true)
if [ -n "$UNFORMATTED" ]; then
  fail "gofmt: these files need formatting:\n$UNFORMATTED"
fi
pass "gofmt"

# 2. Vet
echo ""
echo "--- Vet ---"
go vet ./... 2>&1 || fail "go vet failed"
pass "go vet"

# 3. Build
echo ""
echo "--- Build ---"
go build ./... 2>&1 || fail "go build failed"
pass "go build"

# 4. Tests (short mode for speed)
echo ""
echo "--- Tests ---"
RESULT=$(gotest ./... -short -count=1 2>&1) || true
PASS_COUNT=$(echo "$RESULT" | grep -c '^ok' || true)
FAIL_COUNT=$(echo "$RESULT" | grep -c '^FAIL' || true)
if [ "$FAIL_COUNT" -gt 0 ]; then
  echo "$RESULT" | grep '^FAIL'
  fail "tests failed ($FAIL_COUNT packages)"
fi
pass "tests ($PASS_COUNT packages)"

# Race detector and coverage are deferred to CI (`make test-race` and
# `make coverage` in .github/workflows/ci.yml) to keep local commits fast — the
# race run alone added ~50s. They are still enforced as required checks on every
# PR, so nothing merges to main without passing them.

# 5. Complexity ratchet (cyclomatic + cognitive + FILE-SIZE, whole-repo baseline).
# Runs the EXACT same check as `make complexity` and CI (scripts/complexity/gate.sh)
# so nothing can slip through the hook that CI would catch. A staged-only,
# per-function check used to live here; it silently missed file-size regressions
# (a new/worse `filesize|...` entry committed clean and only tripped CI). The
# gate scans the working tree, is baseline-aware (a NEW over-8 function still
# fails as a new entry), and is designed to hard-fail rather than pass if it
# cannot run its analyzers — so it is impossible to skip, not merely usually run.
echo ""
echo "--- Complexity ---"
if ! bash scripts/complexity/gate.sh gate; then
  fail "complexity ratchet: new/worse cyclomatic, cognitive, or file-size violation (see above). Fix it, or 'make complexity-update' if a decomposition legitimately shrank the baseline."
fi
pass "complexity ratchet (no new/worse violations vs baseline)"

# 6. Dippin lint (core pipelines only, for speed)

echo ""
echo "--- Dippin Lint ---"
if command -v dippin >/dev/null 2>&1; then
  LINT_FAIL=0
  for f in examples/ask_and_execute.dip examples/build_product.dip examples/build_product_with_superspec.dip examples/deep_review.dip; do
    ERRORS=$(dippin check "$f" 2>&1 | python3 -c "import sys,json; d=json.loads(sys.stdin.read()); print(d.get('errors',0))" 2>/dev/null || echo "0")
    if [ "$ERRORS" -gt 0 ]; then
      echo "  $f: $ERRORS errors"
      LINT_FAIL=1
    fi
  done
  if [ "$LINT_FAIL" -gt 0 ]; then
    fail "dippin lint errors in core pipelines"
  fi
  pass "dippin lint (core pipelines)"
else
  warn "dippin CLI not found — skipping .dip lint"
fi

# 7. Docs drift (fast, grep-only): every CLI command must be documented on the
# website. Same check as `make docs-check` and CI, run here so a new subcommand
# can't commit without a cli.html entry. The release-version half lives in
# release.yml (versions aren't cut at commit time).
echo ""
echo "--- Docs ---"
if ! bash scripts/docs/gate.sh cli-coverage; then
  fail "a CLI command is undocumented on the website (see above) — add a block to site/content/cli.html"
fi
pass "docs drift (CLI commands documented)"

echo ""
echo "═══ All gates passed ═══"
